<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.LieuTouristiqueFormDialogController"
            styleClass="dialog-pane">
    <content>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="dialog-scroll">
            <VBox spacing="0" styleClass="dialog-content-root">

                <!-- Dialog Header Section -->
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="dialog-header-section">
                    <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>
                    <Label text="🏛️" style="-fx-font-size: 42px;"/>
                    <VBox spacing="4">
                        <Label text="Lieu Touristique" styleClass="dialog-page-title"/>
                        <Label text="Définir les détails du lieu touristique" styleClass="dialog-page-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Gold Separator -->
                <Region styleClass="accent-line" prefHeight="2" maxHeight="2"/>

                <!-- Form Content -->
                <HBox spacing="40" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

                    <!-- Left Column -->
                    <VBox spacing="25" HBox.hgrow="ALWAYS" styleClass="form-section">
                        <padding><Insets top="30" right="35" bottom="30" left="35"/></padding>
                        <Label text="ℹ️ Informations générales" styleClass="form-section-title"/>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Nom" styleClass="form-field-label"/>
                            <TextField fx:id="tfNom" promptText="Nom du lieu..." styleClass="form-input" prefHeight="48"/>
                        </VBox>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Description" styleClass="form-field-label"/>
                            <TextField fx:id="tfDescription" promptText="Description détaillée..." styleClass="form-input" prefHeight="48"/>
                        </VBox>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Ville" styleClass="form-field-label"/>
                            <TextField fx:id="tfVille" promptText="Ville..." styleClass="form-input" prefHeight="48"/>
                        </VBox>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Prix (TND)" styleClass="form-field-label"/>
                            <TextField fx:id="tfPrix" promptText="0.00" styleClass="form-input" prefHeight="48"/>
                        </VBox>
                    </VBox>

                    <!-- Right Column -->
                    <VBox spacing="25" HBox.hgrow="ALWAYS" styleClass="form-section">
                        <padding><Insets top="30" right="35" bottom="30" left="35"/></padding>
                        <Label text="🔗 Détails et médias" styleClass="form-section-title"/>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Image" styleClass="form-field-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="tfImage" promptText="Chemin de l'image..." styleClass="form-input" prefHeight="48" HBox.hgrow="ALWAYS"/>
                                <Button text="📁 Parcourir" fx:id="btnChooseImage" styleClass="btn-browse"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Statut" styleClass="form-field-label"/>
                            <TextField fx:id="tfStatut" promptText="1 = Actif, 0 = Inactif" styleClass="form-input" prefHeight="48"/>
                        </VBox>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Catégorie" styleClass="form-field-label"/>
                            <ComboBox fx:id="cbCategorie" promptText="Sélectionner une catégorie..." styleClass="form-combo" prefHeight="48" maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="10" styleClass="form-group">
                            <Label text="Adresse" styleClass="form-field-label"/>
                            <ComboBox fx:id="cbAdresse" promptText="Sélectionner une adresse..." styleClass="form-combo" prefHeight="48" maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <!-- Image Preview -->
                        <VBox alignment="CENTER" styleClass="image-preview-card" spacing="8">
                            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
                            <Label text="🖼️ Aperçu" styleClass="form-field-label"/>
                            <ImageView fx:id="imagePreview" fitWidth="200" fitHeight="130" preserveRatio="true"/>
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </content>
    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>

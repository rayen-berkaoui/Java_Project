<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.MainInterfaceController"
            prefWidth="1280" prefHeight="820"
            style="-fx-padding: 0; -fx-border-width: 0;"
            styleClass="root">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- TOP BAR                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <top>
        <VBox spacing="0">
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #080808; -fx-padding: 12 25;">

                <!-- Brand -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane prefWidth="36" prefHeight="36"
                               style="-fx-background-color: rgba(255,215,0,0.12); -fx-background-radius: 10;">
                        <Label text="&#x2708;" style="-fx-font-size: 16;" />
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="SMARTTRAVEL" style="-fx-font-size: 16; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Label text="Voyage &amp; Loisirs" style="-fx-font-size: 9; -fx-text-fill: #666666;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search bar -->
                <HBox spacing="0" alignment="CENTER"
                      style="-fx-background-color: rgba(255,255,255,0.04); -fx-padding: 0; -fx-background-radius: 20; -fx-border-color: rgba(255,215,0,0.08); -fx-border-radius: 20; -fx-border-width: 1;">
                    <Label text="&#x1F50D;" style="-fx-font-size: 12; -fx-padding: 0 0 0 14;" />
                    <TextField promptText="Rechercher une destination..." prefWidth="260"
                               style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-prompt-text-fill: #555; -fx-padding: 8 14; -fx-font-size: 12; -fx-border-width: 0;" />
                </HBox>

                <Region prefWidth="15" />

                <!-- User badge (clickable to profile) -->
                <HBox spacing="8" alignment="CENTER" onMouseClicked="#handleShowProfil"
                      style="-fx-background-color: rgba(255,215,0,0.05); -fx-padding: 6 16; -fx-background-radius: 20; -fx-cursor: hand;">
                    <StackPane prefWidth="26" prefHeight="26"
                               style="-fx-background-color: rgba(255,215,0,0.15); -fx-background-radius: 13;">
                        <Label text="&#x1F464;" style="-fx-font-size: 11;" />
                    </StackPane>
                    <Label fx:id="userNameLabel" text="Voyageur" style="-fx-text-fill: #FFD700; -fx-font-size: 12; -fx-font-weight: bold;" />
                </HBox>

                <Region prefWidth="12" />

                <!-- Actions -->
                <HBox spacing="8" alignment="CENTER">
                    <Button text="&#x1F6AA; Deconnexion" styleClass="dashboard-button-danger" onAction="#handleLogout"
                            style="-fx-padding: 8 16; -fx-font-size: 11;" />
                </HBox>

                <Region prefWidth="10" />

                <HBox spacing="2">
                    <Button text="&#x2014;" onAction="#handleMinimize" styleClass="window-button" />
                    <Button text="&#x2715;" onAction="#handleClose" styleClass="window-button-close" />
                </HBox>
            </HBox>

            <!-- Gold accent line -->
            <Region style="-fx-background-color: linear-gradient(to right, rgba(255,215,0,0.5), rgba(255,215,0,0.15), rgba(255,215,0,0.02), transparent); -fx-pref-height: 1.5;" />
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CENTER = SIDEBAR + CONTENT                                     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <center>
        <HBox spacing="0">

            <!-- ═══════ SIDEBAR ═══════ -->
            <VBox spacing="0" style="-fx-background-color: #080808; -fx-border-color: transparent rgba(255,215,0,0.06) transparent transparent; -fx-border-width: 0 1 0 0;" prefWidth="260" minWidth="260">

                <!-- Discover -->
                <VBox spacing="4" style="-fx-padding: 24 14 8 14;">
                    <Label text="D&#xc9;COUVRIR" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 0 6 8 6;" />
                    <Button fx:id="navAccueil" text="&#x1F3E0;  Accueil" styleClass="sidebar-button-active" prefWidth="232" onAction="#handleShowAccueil" />
                </VBox>

                <Region prefHeight="6" />
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.08), transparent); -fx-pref-height: 1;" />
                <Region prefHeight="6" />

                <!-- Explorer -->
                <VBox spacing="4" style="-fx-padding: 8 14;">
                    <Label text="EXPLORER" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 0 6 8 6;" />
                    <Button fx:id="navLieux" text="&#x1F5FA;  Destinations" styleClass="sidebar-button" prefWidth="232" onAction="#handleShowLieux" />
                    <Button fx:id="navRestaurants" text="&#x1F37D;  Restaurants &amp; Loisirs" styleClass="sidebar-button" prefWidth="232" onAction="#handleShowRestaurants" />
                </VBox>

                <Region prefHeight="6" />
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.08), transparent); -fx-pref-height: 1;" />
                <Region prefHeight="6" />

                <!-- Mon Espace -->
                <VBox spacing="4" style="-fx-padding: 8 14;">
                    <Label text="MON ESPACE" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 0 6 8 6;" />
                    <Button fx:id="navAvis" text="&#x2B50;  Mes Avis" styleClass="sidebar-button" prefWidth="232" onAction="#handleShowAvis" />
                    <Button fx:id="navReservations" text="&#x1F4C5;  Mes Reservations" styleClass="sidebar-button" prefWidth="232" onAction="#handleShowReservations" />
                </VBox>

                <Region prefHeight="6" />
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.08), transparent); -fx-pref-height: 1;" />
                <Region prefHeight="6" />

                <!-- Compte -->
                <VBox spacing="4" style="-fx-padding: 8 14;">
                    <Label text="COMPTE" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 0 6 8 6;" />
                    <Button fx:id="navProfil" text="&#x1F464;  Mon Profil" styleClass="sidebar-button" prefWidth="232" onAction="#handleShowProfil" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Sidebar Footer -->
                <VBox spacing="4" style="-fx-padding: 14;">
                    <Region style="-fx-background-color: rgba(255,255,255,0.03); -fx-pref-height: 1;" />
                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 8 6;">
                        <StackPane prefWidth="24" prefHeight="24"
                                   style="-fx-background-color: rgba(255,215,0,0.08); -fx-background-radius: 6;">
                            <Label text="&#x2708;" style="-fx-font-size: 10;" />
                        </StackPane>
                        <VBox spacing="0">
                            <Label text="SmartTravel v1.0" style="-fx-text-fill: #444444; -fx-font-size: 10;" />
                            <Label text="2025-2026" style="-fx-text-fill: #333333; -fx-font-size: 8;" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- CONTENT AREA (StackPane for panel switching)           -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #0a0a0a;">

                <!-- ======================= ACCUEIL PANEL ======================= -->
                <ScrollPane fx:id="panelAccueil" fitToWidth="true" hbarPolicy="NEVER"
                            style="-fx-background: #0a0a0a; -fx-background-color: #0a0a0a; -fx-padding: 0;">
                    <VBox spacing="24" style="-fx-padding: 30;">

                        <!-- Welcome Banner -->
                        <HBox alignment="CENTER_LEFT" spacing="16"
                              style="-fx-background-color: linear-gradient(to right, rgba(255,215,0,0.08), rgba(255,215,0,0.02)); -fx-padding: 28 32; -fx-background-radius: 16; -fx-border-color: rgba(255,215,0,0.1); -fx-border-radius: 16; -fx-border-width: 1;">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label fx:id="welcomeLabel" text="&#x1F30D; Bonjour, Voyageur !" style="-fx-font-size: 24; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                                <Label text="Pret a explorer ? Decouvrez les meilleures destinations et experiences en Tunisie." style="-fx-font-size: 13; -fx-text-fill: #999999;" />
                            </VBox>
                            <StackPane prefWidth="60" prefHeight="60"
                                       style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 30;">
                                <Label text="&#x2708;" style="-fx-font-size: 28;" />
                            </StackPane>
                        </HBox>

                        <!-- Quick Actions -->
                        <HBox spacing="14">
                            <Button text="&#x1F5FA;  Explorer les Destinations" styleClass="dashboard-button" onAction="#handleShowLieux"
                                    style="-fx-padding: 12 24; -fx-font-size: 12;" />
                            <Button text="&#x1F37D;  Trouver un Restaurant" styleClass="dashboard-button" onAction="#handleShowRestaurants"
                                    style="-fx-padding: 12 24; -fx-font-size: 12;" />
                            <Button text="&#x1F4C5;  Mes Reservations" styleClass="dashboard-button" onAction="#handleShowReservations"
                                    style="-fx-padding: 12 24; -fx-font-size: 12;" />
                            <Button text="&#x1F464;  Mon Profil" styleClass="dashboard-button" onAction="#handleShowProfil"
                                    style="-fx-padding: 12 24; -fx-font-size: 12;" />
                        </HBox>

                        <!-- Stats Cards -->
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="stat-card"
                                  style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="40" prefHeight="40"
                                               style="-fx-background-color: rgba(100,181,246,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F5FA;" style="-fx-font-size: 18;" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label text="Destinations" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                        <Label text="24 a explorer" style="-fx-text-fill: #64B5F6; -fx-font-size: 20; -fx-font-weight: bold;" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="stat-card"
                                  style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="40" prefHeight="40"
                                               style="-fx-background-color: rgba(255,167,38,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F37D;" style="-fx-font-size: 18;" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label text="Restaurants &amp; Loisirs" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                        <Label text="18 disponibles" style="-fx-text-fill: #FFA726; -fx-font-size: 20; -fx-font-weight: bold;" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="stat-card"
                                  style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="40" prefHeight="40"
                                               style="-fx-background-color: rgba(81,207,102,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F4C5;" style="-fx-font-size: 18;" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label text="Mes Reservations" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                        <Label text="3 a venir" style="-fx-text-fill: #51CF66; -fx-font-size: 20; -fx-font-weight: bold;" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="stat-card"
                                  style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <StackPane prefWidth="40" prefHeight="40"
                                               style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x2764;" style="-fx-font-size: 18;" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label text="Mes Favoris" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                        <Label text="4 sauvegardes" style="-fx-text-fill: #FFD700; -fx-font-size: 20; -fx-font-weight: bold;" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Two columns: Popular + My Activity -->
                        <HBox spacing="16">

                            <!-- Destinations Tendance -->
                            <VBox spacing="14" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                <Label text="&#x1F525; Destinations Tendance" style="-fx-font-size: 15; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />

                                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 12; -fx-background-color: rgba(255,255,255,0.02); -fx-background-radius: 10; -fx-cursor: hand;" onMouseClicked="#handleShowLieux">
                                    <StackPane prefWidth="44" prefHeight="44" style="-fx-background-color: rgba(100,181,246,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F3DB;" style="-fx-font-size: 20;" />
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Medina de Tunis" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" />
                                        <Label text="Historique - 4.8 etoiles" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    </VBox>
                                    <Label text="235 avis" styleClass="badge-gold" style="-fx-font-size: 10; -fx-padding: 4 10; -fx-background-radius: 10;" />
                                </HBox>

                                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 12; -fx-background-color: rgba(255,255,255,0.02); -fx-background-radius: 10; -fx-cursor: hand;" onMouseClicked="#handleShowLieux">
                                    <StackPane prefWidth="44" prefHeight="44" style="-fx-background-color: rgba(81,207,102,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F3D6;" style="-fx-font-size: 20;" />
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Plage de Sidi Bou Said" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" />
                                        <Label text="Nature - 4.6 etoiles" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    </VBox>
                                    <Label text="189 avis" styleClass="badge-green" style="-fx-font-size: 10; -fx-padding: 4 10; -fx-background-radius: 10;" />
                                </HBox>

                                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 12; -fx-background-color: rgba(255,255,255,0.02); -fx-background-radius: 10; -fx-cursor: hand;" onMouseClicked="#handleShowLieux">
                                    <StackPane prefWidth="44" prefHeight="44" style="-fx-background-color: rgba(255,167,38,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F3DC;" style="-fx-font-size: 20;" />
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Desert de Douz" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" />
                                        <Label text="Aventure - 4.7 etoiles" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    </VBox>
                                    <Label text="178 avis" styleClass="badge-gold" style="-fx-font-size: 10; -fx-padding: 4 10; -fx-background-radius: 10;" />
                                </HBox>

                                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 12; -fx-background-color: rgba(255,255,255,0.02); -fx-background-radius: 10; -fx-cursor: hand;" onMouseClicked="#handleShowLieux">
                                    <StackPane prefWidth="44" prefHeight="44" style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 10;">
                                        <Label text="&#x1F3DB;" style="-fx-font-size: 20;" />
                                    </StackPane>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Amphitheatre d'El Jem" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" />
                                        <Label text="Historique - 4.9 etoiles" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    </VBox>
                                    <Label text="312 avis" styleClass="badge-green" style="-fx-font-size: 10; -fx-padding: 4 10; -fx-background-radius: 10;" />
                                </HBox>
                            </VBox>

                            <!-- Right column: My Activity -->
                            <VBox spacing="16" HBox.hgrow="ALWAYS">

                                <!-- My Upcoming Reservations -->
                                <VBox spacing="12"
                                      style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                    <Label text="&#x1F4C5; Mes Prochaines Sorties" style="-fx-font-size: 15; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />

                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(81,207,102,0.05); -fx-background-radius: 8; -fx-border-color: rgba(81,207,102,0.15); -fx-border-radius: 8; -fx-border-width: 1;">
                                        <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: rgba(81,207,102,0.1); -fx-background-radius: 8;">
                                            <Label text="&#x2713;" style="-fx-font-size: 14; -fx-text-fill: #51CF66; -fx-font-weight: bold;" />
                                        </StackPane>
                                        <VBox spacing="1" HBox.hgrow="ALWAYS">
                                            <Label text="Restaurant Le Baroque" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;" />
                                            <Label text="18 Fev 2026 - 20:00 - 4 personnes" style="-fx-text-fill: #888888; -fx-font-size: 10;" />
                                        </VBox>
                                        <Label text="Confirmee" styleClass="badge-green" style="-fx-font-size: 10; -fx-padding: 4 10;" />
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(255,215,0,0.03); -fx-background-radius: 8; -fx-border-color: rgba(255,215,0,0.1); -fx-border-radius: 8; -fx-border-width: 1;">
                                        <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 8;">
                                            <Label text="&#x23F3;" style="-fx-font-size: 14;" />
                                        </StackPane>
                                        <VBox spacing="1" HBox.hgrow="ALWAYS">
                                            <Label text="Visite Guidee - Carthage" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;" />
                                            <Label text="22 Fev 2026 - 09:00 - 2 personnes" style="-fx-text-fill: #888888; -fx-font-size: 10;" />
                                        </VBox>
                                        <Label text="En attente" styleClass="badge-gold" style="-fx-font-size: 10; -fx-padding: 4 10;" />
                                    </HBox>
                                </VBox>

                                <!-- My Recent Reviews -->
                                <VBox spacing="12"
                                      style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                                    <Label text="&#x2B50; Mes Derniers Avis" style="-fx-font-size: 15; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />

                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(255,255,255,0.02); -fx-background-radius: 8;">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <HBox spacing="6" alignment="CENTER_LEFT">
                                                <Label text="Medina de Tunis" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;" />
                                                <Label text="5/5" style="-fx-text-fill: #FFD700; -fx-font-size: 10; -fx-font-weight: bold;" />
                                            </HBox>
                                            <Label text="Magnifique endroit, je recommande vivement !" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                        </VBox>
                                        <Label text="il y a 2h" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(255,255,255,0.02); -fx-background-radius: 8;">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <HBox spacing="6" alignment="CENTER_LEFT">
                                                <Label text="Le Baroque" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;" />
                                                <Label text="4/5" style="-fx-text-fill: #FFD700; -fx-font-size: 10; -fx-font-weight: bold;" />
                                            </HBox>
                                            <Label text="Tres bon restaurant, service rapide." style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                        </VBox>
                                        <Label text="il y a 5h" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- ======================= DESTINATIONS PANEL ======================= -->
                <ScrollPane fx:id="panelLieux" fitToWidth="true" hbarPolicy="NEVER" visible="false"
                            style="-fx-background: #0a0a0a; -fx-background-color: #0a0a0a;">
                    <VBox spacing="20" style="-fx-padding: 30;">

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="&#x1F5FA; Explorer les Destinations" style="-fx-font-size: 22; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="12 destinations disponibles" style="-fx-text-fill: #666666; -fx-font-size: 12;" />
                        </HBox>


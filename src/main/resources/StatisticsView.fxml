<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.StatisticsController"
            styleClass="content-scroll" fitToWidth="true" fitToHeight="false"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">

    <VBox fx:id="statsRoot" spacing="24" styleClass="content-root">
        <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

        <!-- ===== PAGE HEADER ===== -->
        <HBox styleClass="page-header-banner" alignment="CENTER_LEFT" spacing="0" maxHeight="120">
            <VBox alignment="CENTER" styleClass="header-icon-badge">
                <Label text="📈" styleClass="header-icon-emoji"/>
            </VBox>
            <VBox spacing="4" styleClass="header-title-block" HBox.hgrow="ALWAYS">
                <Label text="ANALYSE AVANCÉE" styleClass="header-tag"/>
                <Label text="Statistiques &amp; Analytics" styleClass="header-main-title"/>
                <Label text="Analyse détaillée des données touristiques avec indicateurs clés" styleClass="header-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRefresh" text="🔄  Actualiser" styleClass="action-button"
                    onAction="#refreshStats" prefHeight="38" minWidth="140"/>
        </HBox>

        <!-- ===== KPI CARDS ROW ===== -->
        <HBox spacing="16" alignment="CENTER">
            <VBox spacing="4" alignment="CENTER" styleClass="dashboard-stat-card, stats-kpi-card" HBox.hgrow="ALWAYS" minHeight="110">
                <Label text="💰" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblAvgPrice" text="0 TND" styleClass="stats-kpi-value"/>
                <Label text="Prix Moyen" styleClass="dashboard-stat-label"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" styleClass="dashboard-stat-card, stats-kpi-card" HBox.hgrow="ALWAYS" minHeight="110">
                <Label text="📈" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblMaxPrice" text="0 TND" styleClass="stats-kpi-value"/>
                <Label text="Prix Maximum" styleClass="dashboard-stat-label"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" styleClass="dashboard-stat-card, stats-kpi-card" HBox.hgrow="ALWAYS" minHeight="110">
                <Label text="📉" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblMinPrice" text="0 TND" styleClass="stats-kpi-value"/>
                <Label text="Prix Minimum" styleClass="dashboard-stat-label"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" styleClass="dashboard-stat-card, stats-kpi-card" HBox.hgrow="ALWAYS" minHeight="110">
                <Label text="✅" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblActiveRate" text="0%" styleClass="stats-kpi-value"/>
                <Label text="Taux d'Activité" styleClass="dashboard-stat-label"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" styleClass="dashboard-stat-card, stats-kpi-card" HBox.hgrow="ALWAYS" minHeight="110">
                <Label text="🏙️" style="-fx-font-size: 26px;"/>
                <Label fx:id="lblTopCity" text="-" styleClass="stats-kpi-value"/>
                <Label text="Ville #1" styleClass="dashboard-stat-label"/>
            </VBox>
        </HBox>

        <!-- ===== CHARTS ROW 1: Price Analysis ===== -->
        <HBox spacing="20" VBox.vgrow="NEVER">
            <VBox spacing="10" styleClass="dashboard-chart-card" HBox.hgrow="ALWAYS" minHeight="340">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="💰  Répartition des Prix (Histogramme)" styleClass="dashboard-chart-title"/>
                <Region styleClass="accent-line-thin"/>
                <VBox fx:id="chartPriceHistogram" VBox.vgrow="ALWAYS" alignment="CENTER"/>
            </VBox>
            <VBox spacing="10" styleClass="dashboard-chart-card" HBox.hgrow="ALWAYS" minHeight="340">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="📂  Catégories — Nombre de Lieux" styleClass="dashboard-chart-title"/>
                <Region styleClass="accent-line-thin"/>
                <VBox fx:id="chartCategoryBar" VBox.vgrow="ALWAYS" alignment="CENTER"/>
            </VBox>
        </HBox>

        <!-- ===== CHARTS ROW 2: Geography & Trend ===== -->
        <HBox spacing="20" VBox.vgrow="NEVER">
            <VBox spacing="10" styleClass="dashboard-chart-card" HBox.hgrow="ALWAYS" minHeight="340">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="🏙️  Lieux par Ville (Top 10)" styleClass="dashboard-chart-title"/>
                <Region styleClass="accent-line-thin"/>
                <VBox fx:id="chartCityPie" VBox.vgrow="ALWAYS" alignment="CENTER"/>
            </VBox>
            <VBox spacing="10" styleClass="dashboard-chart-card" HBox.hgrow="ALWAYS" minHeight="340">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="📊  Prix Moyen par Catégorie" styleClass="dashboard-chart-title"/>
                <Region styleClass="accent-line-thin"/>
                <VBox fx:id="chartAvgPriceCat" VBox.vgrow="ALWAYS" alignment="CENTER"/>
            </VBox>
        </HBox>

        <!-- ===== CHARTS ROW 3: Availability & Category Categories ===== -->
        <HBox spacing="20" VBox.vgrow="NEVER">
            <VBox spacing="10" styleClass="dashboard-chart-card" HBox.hgrow="ALWAYS" minHeight="340">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="✅  Statut des Lieux (Actif vs Inactif)" styleClass="dashboard-chart-title"/>
                <Region styleClass="accent-line-thin"/>
                <VBox fx:id="chartStatusDonut" VBox.vgrow="ALWAYS" alignment="CENTER"/>
            </VBox>
            <VBox spacing="10" styleClass="dashboard-chart-card" HBox.hgrow="ALWAYS" minHeight="340">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="📅  Catégories par Date de Création" styleClass="dashboard-chart-title"/>
                <Region styleClass="accent-line-thin"/>
                <VBox fx:id="chartCatTimeline" VBox.vgrow="ALWAYS" alignment="CENTER"/>
            </VBox>
        </HBox>

        <!-- ===== TOP PLACES TABLE ===== -->
        <VBox spacing="10" styleClass="dashboard-chart-card" VBox.vgrow="NEVER">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label text="🏆  Top 5 Lieux les Plus Chers" styleClass="dashboard-chart-title"/>
            <Region styleClass="accent-line-thin"/>
            <VBox fx:id="topPlacesBox" spacing="8"/>
        </VBox>

    </VBox>
</ScrollPane>

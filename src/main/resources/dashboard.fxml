                            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 5 0;"><Label fx:id="settingsMessageLabel" text="" style="-fx-font-size: 12;" /><Button text="&#x1F4BE; Sauvegarder" styleClass="login-button-modern" onAction="#handleSaveSettings" style="-fx-font-size: 12; -fx-padding: 10 28;" /></HBox>

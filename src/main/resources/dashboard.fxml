                        <VBox spacing="6" VBox.vgrow="ALWAYS"><Label text="DESCRIPTION" styleClass="field-label" /><TextArea fx:id="ticketDescriptionArea" promptText="Decrivez votre probleme en detail..." VBox.vgrow="ALWAYS" wrapText="true" style="-fx-background-color: rgba(18,18,18,0.9); -fx-text-fill: #ffffff; -fx-border-color: rgba(255,215,0,0.08); -fx-border-radius: 10; -fx-background-radius: 10;" /></VBox>
                        <HBox spacing="15" alignment="CENTER_RIGHT"><Label fx:id="ticketMessageLabel" text="" style="-fx-font-size: 12;" /><Button text="&#x1F4E4; Soumettre" styleClass="login-button-modern" onAction="#handleSubmitTicket" style="-fx-font-size: 12; -fx-padding: 10 28;" /></HBox>

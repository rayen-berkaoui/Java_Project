<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.DashboardController"
            prefWidth="1280" prefHeight="820"
            style="-fx-padding: 0; -fx-border-width: 0;"
            styleClass="root">

    <!-- ═══════ TOP BAR ═══════ -->
    <top>
        <VBox spacing="0">
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #080808; -fx-padding: 12 25;">

                <!-- Brand -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane prefWidth="32" prefHeight="32"
                               style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 8;">
                        <Label text="📊" style="-fx-font-size: 14;" />
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="TABAANI" style="-fx-font-size: 15; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Label text="Dashboard" style="-fx-font-size: 9; -fx-text-fill: #666666;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- User info -->
                <HBox spacing="8" alignment="CENTER"
                      style="-fx-background-color: rgba(255,215,0,0.05); -fx-padding: 6 16; -fx-background-radius: 20;">
                    <Label text="👤" style="-fx-font-size: 12;" />
                    <Label fx:id="userNameLabel" text="" style="-fx-text-fill: #FFD700; -fx-font-size: 12; -fx-font-weight: bold;" />
                </HBox>

                <Region prefWidth="12" />

                <HBox spacing="8" alignment="CENTER">
                    <Button text="👤 Profil" styleClass="dashboard-button" onAction="#handleViewProfile"
                            style="-fx-padding: 8 16; -fx-font-size: 11;" />
                    <Button text="🚪 Déconnexion" styleClass="dashboard-button-danger" onAction="#handleLogout"
                            style="-fx-padding: 8 16; -fx-font-size: 11;" />
                </HBox>

                <Region prefWidth="10" />

                <HBox spacing="2">
                    <Button text="—" onAction="#handleMinimize" styleClass="window-button" />
                    <Button text="✕" onAction="#handleClose" styleClass="window-button-close" />
                </HBox>
            </HBox>

            <!-- Accent line -->
            <Region style="-fx-background-color: linear-gradient(to right, rgba(255,215,0,0.4), rgba(255,215,0,0.08), transparent); -fx-pref-height: 1;" />
        </VBox>
    </top>

    <!-- ═══════ CENTER ═══════ -->
    <center>
        <HBox spacing="0">

            <!-- ═══════ SIDEBAR ═══════ -->
            <VBox spacing="0" style="-fx-background-color: #080808; -fx-border-color: transparent rgba(255,215,0,0.06) transparent transparent; -fx-border-width: 0 1 0 0;" prefWidth="240" minWidth="240">

                <VBox spacing="4" style="-fx-padding: 24 14 8 14;">
                    <Label text="NAVIGATION" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 0 6 8 6;" />

                    <Button fx:id="btnDashboard" text="📈  Tableau de bord" styleClass="sidebar-button-active" prefWidth="212" onAction="#handleShowDashboard" />
                </VBox>

                <Region prefHeight="8" />
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.1), transparent); -fx-pref-height: 1;" />
                <Region prefHeight="8" />

                <VBox spacing="4" style="-fx-padding: 8 14;">
                    <Label text="SYSTÈME" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 0 6 8 6;" />

                    <Button fx:id="btnSettings" text="⚙  Paramètres" styleClass="sidebar-button" prefWidth="212" onAction="#handleShowSettings" />
                    <Button fx:id="btnSupport" text="📞  Support" styleClass="sidebar-button" prefWidth="212" onAction="#handleShowSupport" />
                </VBox>

                <Region prefHeight="8" />
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.1), transparent); -fx-pref-height: 1;" />
                <Region prefHeight="8" />

                <VBox spacing="4" style="-fx-padding: 8 14;">
                    <Button text="🛡  Admin Panel" styleClass="sidebar-button" prefWidth="212" onAction="#handleGoToAdmin" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Sidebar footer -->
                <VBox spacing="4" style="-fx-padding: 14;">
                    <Region style="-fx-background-color: rgba(255,255,255,0.03); -fx-pref-height: 1;" />
                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 8 6;">
                        <StackPane prefWidth="24" prefHeight="24"
                                   style="-fx-background-color: rgba(255,215,0,0.08); -fx-background-radius: 6;">
                            <Label text="📊" style="-fx-font-size: 10;" />
                        </StackPane>
                        <Label text="Tabaani v1.0" style="-fx-text-fill: #444444; -fx-font-size: 10;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- ═══════ MAIN CONTENT ═══════ -->
            <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS" style="-fx-background-color: #0a0a0a;">

                <!-- ============ DASHBOARD PANEL ============ -->
                <VBox fx:id="dashboardPane" spacing="22" style="-fx-background-color: #0a0a0a; -fx-padding: 28;">

                    <!-- Welcome Banner -->
                    <HBox spacing="0" alignment="CENTER_LEFT"
                          style="-fx-background-color: linear-gradient(to right, rgba(255,215,0,0.08), rgba(255,215,0,0.02), transparent); -fx-padding: 24 28; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.1); -fx-border-radius: 14; -fx-border-width: 1;">
                        <VBox spacing="6">
                            <Label fx:id="welcomeLabel" text="Bienvenue 👋"
                                   style="-fx-font-size: 22; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                            <Label text="Tableau de bord — vue d'ensemble en temps réel"
                                   style="-fx-text-fill: #888888; -fx-font-size: 12;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="🔄 Rafraîchir" styleClass="dashboard-button" onAction="#handleRefreshDashboard"
                                style="-fx-padding: 8 20; -fx-font-size: 11;" />
                    </HBox>

                    <!-- Stats Cards -->
                    <HBox spacing="14">
                        <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane prefWidth="42" prefHeight="42"
                                           style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 12;">
                                    <Label text="👥" style="-fx-font-size: 18;" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Total Utilisateurs" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 24; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane prefWidth="42" prefHeight="42"
                                           style="-fx-background-color: rgba(81,207,102,0.1); -fx-background-radius: 12;">
                                    <Label text="✅" style="-fx-font-size: 18;" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Utilisateurs Actifs" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    <Label fx:id="activeUsersLabel" text="0" style="-fx-font-size: 24; -fx-text-fill: #51CF66; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane prefWidth="42" prefHeight="42"
                                           style="-fx-background-color: rgba(255,107,107,0.1); -fx-background-radius: 12;">
                                    <Label text="🚫" style="-fx-font-size: 18;" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Utilisateurs Bloqués" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    <Label fx:id="blockedUsersLabel" text="0" style="-fx-font-size: 24; -fx-text-fill: #FF6B6B; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane prefWidth="42" prefHeight="42"
                                           style="-fx-background-color: rgba(100,181,246,0.1); -fx-background-radius: 12;">
                                    <Label text="🏷" style="-fx-font-size: 18;" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Total Rôles" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                    <Label fx:id="totalRolesLabel" text="0" style="-fx-font-size: 24; -fx-text-fill: #64B5F6; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Recent Users -->
                    <VBox spacing="12" styleClass="content-card" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📝" style="-fx-font-size: 15;" />
                            <Label text="Derniers inscrits" style="-fx-text-fill: #FFD700; -fx-font-size: 14; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="badge-gold" text="Récent" />
                        </HBox>
                        <Separator />
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <VBox fx:id="recentUsersContainer" spacing="8" />
                        </ScrollPane>
                    </VBox>
                </VBox>

                <!-- ============ SETTINGS PANEL ============ -->
                <VBox fx:id="settingsPane" spacing="22" style="-fx-background-color: #0a0a0a; -fx-padding: 28;" visible="false">
                    <VBox spacing="3">
                        <Label text="Paramètres" style="-fx-font-size: 22; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                        <Label text="Configurer les préférences du système" style="-fx-text-fill: #666666; -fx-font-size: 12;" />
                    </VBox>

                    <ScrollPane style="-fx-background-color: transparent; -fx-padding: 0;" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <VBox spacing="18">

                            <!-- Notifications -->
                            <VBox spacing="15" styleClass="content-card">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="🔔" style="-fx-font-size: 15;" />
                                    <Label text="Notifications" style="-fx-text-fill: #FFD700; -fx-font-size: 14; -fx-font-weight: bold;" />
                                </HBox>
                                <Separator />
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Notifications Email" style="-fx-text-fill: #ffffff; -fx-font-size: 13;" />
                                        <Label text="Recevoir les alertes par email" style="-fx-text-fill: #666666; -fx-font-size: 11;" />
                                    </VBox>
                                    <CheckBox fx:id="emailNotifCheckbox" selected="true" styleClass="custom-checkbox" />
                                </HBox>
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Authentification à deux facteurs" style="-fx-text-fill: #ffffff; -fx-font-size: 13;" />
                                        <Label text="Ajouter une couche de sécurité supplémentaire" style="-fx-text-fill: #666666; -fx-font-size: 11;" />
                                    </VBox>
                                    <CheckBox fx:id="twoFactorCheckbox" styleClass="custom-checkbox" />
                                </HBox>
                            </VBox>

                            <!-- Appearance -->
                            <VBox spacing="15" styleClass="content-card">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="🎨" style="-fx-font-size: 15;" />
                                    <Label text="Apparence" style="-fx-text-fill: #FFD700; -fx-font-size: 14; -fx-font-weight: bold;" />
                                </HBox>
                                <Separator />
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <Label text="Langue" style="-fx-text-fill: #cccccc; -fx-font-size: 13;" prefWidth="150" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <ComboBox fx:id="languageComboBox" prefWidth="200"
                                              style="-fx-background-color: rgba(18,18,18,0.9); -fx-border-color: rgba(255,215,0,0.15); -fx-border-radius: 8; -fx-background-radius: 8;">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Français" />
                                                <String fx:value="English" />
                                                <String fx:value="العربية" />
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </HBox>
                            </VBox>

                            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 5 0;">
                                <Label fx:id="settingsMessageLabel" text="" style="-fx-font-size: 12;" />
                                <Button text="💾 Sauvegarder" styleClass="login-button-modern" onAction="#handleSaveSettings"
                                        style="-fx-font-size: 12; -fx-padding: 10 28;" />
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- ============ SUPPORT PANEL ============ -->
                <VBox fx:id="supportPane" spacing="22" style="-fx-background-color: #0a0a0a; -fx-padding: 28;" visible="false">
                    <VBox spacing="3">
                        <Label text="Centre de Support" style="-fx-font-size: 22; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                        <Label text="Aide et assistance technique" style="-fx-text-fill: #666666; -fx-font-size: 12;" />
                    </VBox>

                    <!-- Contact cards -->
                    <HBox spacing="14">
                        <VBox spacing="12" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(255,215,0,0.08); -fx-background-radius: 14;">
                                <Label text="📚" style="-fx-font-size: 22;" />
                            </StackPane>
                            <Label text="FAQ" style="-fx-text-fill: #FFD700; -fx-font-size: 14; -fx-font-weight: bold;" />
                            <Label text="Questions fréquentes" style="-fx-text-fill: #888888; -fx-font-size: 11;" textAlignment="CENTER" wrapText="true" />
                            <Button text="Consulter" styleClass="button-outline" onAction="#handleViewFAQ" style="-fx-padding: 7 20;" />
                        </VBox>
                        <VBox spacing="12" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(81,207,102,0.08); -fx-background-radius: 14;">
                                <Label text="📧" style="-fx-font-size: 22;" />
                            </StackPane>
                            <Label text="Email Support" style="-fx-text-fill: #51CF66; -fx-font-size: 14; -fx-font-weight: bold;" />
                            <Label text="support@tabaani.com" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                            <Button text="Envoyer" styleClass="button-outline" onAction="#handleSendEmail" style="-fx-padding: 7 20;" />
                        </VBox>
                        <VBox spacing="12" styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER">
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(255,183,77,0.08); -fx-background-radius: 14;">
                                <Label text="💬" style="-fx-font-size: 22;" />
                            </StackPane>
                            <Label text="Chat en direct" style="-fx-text-fill: #FFB74D; -fx-font-size: 14; -fx-font-weight: bold;" />
                            <Label text="Discuter avec notre équipe" style="-fx-text-fill: #888888; -fx-font-size: 11;" textAlignment="CENTER" wrapText="true" />
                            <Button text="Démarrer" styleClass="button-outline" onAction="#handleStartChat" style="-fx-padding: 7 20;" />
                        </VBox>
                    </HBox>

                    <!-- Submit Ticket -->
                    <VBox spacing="15" styleClass="content-card" VBox.vgrow="ALWAYS">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="🎫" style="-fx-font-size: 15;" />
                            <Label text="Soumettre un ticket" style="-fx-text-fill: #FFD700; -fx-font-size: 16; -fx-font-weight: bold;" />
                        </HBox>
                        <Separator />
                        <HBox spacing="15">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="SUJET" styleClass="field-label" />
                                <TextField fx:id="ticketSubjectField" promptText="Décrivez le sujet..." styleClass="text-field-modern" prefHeight="42" />
                            </VBox>
                            <VBox spacing="6" prefWidth="200">
                                <Label text="PRIORITÉ" styleClass="field-label" />
                                <ComboBox fx:id="ticketPriorityCombo" promptText="Sélectionner" prefWidth="200"
                                          style="-fx-background-color: rgba(18,18,18,0.9); -fx-border-color: rgba(255,215,0,0.15); -fx-border-radius: 8; -fx-background-radius: 8;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Faible" />
                                            <String fx:value="Moyen" />
                                            <String fx:value="Élevé" />
                                            <String fx:value="Critique" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                        </HBox>
                        <VBox spacing="6" VBox.vgrow="ALWAYS">
                            <Label text="DESCRIPTION" styleClass="field-label" />
                            <TextArea fx:id="ticketDescriptionArea" promptText="Décrivez votre problème en détail..."
                                      VBox.vgrow="ALWAYS" wrapText="true"
                                      style="-fx-background-color: rgba(18,18,18,0.9); -fx-text-fill: #ffffff; -fx-border-color: rgba(255,215,0,0.08); -fx-border-radius: 10; -fx-background-radius: 10;" />
                        </VBox>
                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Label fx:id="ticketMessageLabel" text="" style="-fx-font-size: 12;" />
                            <Button text="📤 Soumettre" styleClass="login-button-modern" onAction="#handleSubmitTicket"
                                    style="-fx-font-size: 12; -fx-padding: 10 28;" />
                        </HBox>
                    </VBox>
                </VBox>

            </StackPane>
        </HBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.PartenaireInterfaceController" prefWidth="1400" prefHeight="860" style="-fx-background-color: #0a0a0a; -fx-padding: 0; -fx-border-width: 0;" styleClass="root">

    <!-- TOP BAR -->
    <top>
        <VBox spacing="0">
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #080808; -fx-padding: 12 25;">
                <Button fx:id="menuToggleBtn" text="&#x2630;" onAction="#handleToggleDrawer" style="-fx-background-color: transparent; -fx-text-fill: #FFD700; -fx-font-size: 20; -fx-padding: 4 12; -fx-cursor: hand;" mnemonicParsing="false"/>
                <Region prefWidth="8"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: rgba(255,215,0,0.12); -fx-background-radius: 10;">
                        <Label text="&#x1F30D;" style="-fx-font-size: 16;" />
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="TABAANI" style="-fx-font-size: 16; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Label text="ESPACE PARTENAIRE" style="-fx-font-size: 9; -fx-text-fill: #FFA726;" />
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <!-- User badge -->
                <HBox spacing="8" alignment="CENTER" style="-fx-background-color: rgba(255,215,0,0.05); -fx-padding: 6 16; -fx-background-radius: 20;">
                    <StackPane prefWidth="26" prefHeight="26" style="-fx-background-color: rgba(255,215,0,0.15); -fx-background-radius: 13;">
                        <Label text="&#x1F464;" style="-fx-font-size: 11;" />
                    </StackPane>
                    <Label fx:id="userNameLabel" text="Partenaire" style="-fx-text-fill: #FFD700; -fx-font-size: 12; -fx-font-weight: bold;" />
                </HBox>
                <Region prefWidth="12" />
                <HBox spacing="8" alignment="CENTER">
                    <Button text="&#x1F3E0; Accueil" styleClass="dashboard-button" onAction="#handleShowAccueil" style="-fx-padding: 8 16; -fx-font-size: 11;" />
                    <Button text="&#x1F6AA; Deconnexion" styleClass="dashboard-button-danger" onAction="#handleLogout" style="-fx-padding: 8 16; -fx-font-size: 11;" />
                </HBox>
                <Region prefWidth="10" />
                <HBox spacing="2">
                    <Button text="&#x2014;" onAction="#handleMinimize" styleClass="window-button" />
                    <Button fx:id="fullscreenBtn" text="&#x26F6;" onAction="#handleToggleFullscreen" styleClass="window-button" />
                    <Button text="&#x2715;" onAction="#handleClose" styleClass="window-button-close" />
                </HBox>
            </HBox>
            <Region style="-fx-background-color: linear-gradient(to right, rgba(255,165,0,0.5), rgba(255,215,0,0.15), rgba(255,215,0,0.02), transparent); -fx-pref-height: 1.5;" />
        </VBox>
    </top>

    <!-- CENTER: DRAWER BASED LAYOUT -->
    <center>
        <StackPane>
            <!-- ===== MAIN CONTENT ===== -->
            <StackPane style="-fx-padding: 0;">

                <!-- PANEL ACCUEIL PARTENAIRE -->
                <ScrollPane fx:id="panelAccueil" fitToWidth="true" style="-fx-background: #0a0a0a; -fx-background-color: #0a0a0a;" hbarPolicy="NEVER">
                    <VBox spacing="24" style="-fx-padding: 28;">
                        <VBox spacing="6">
                            <Label text="&#x1F4BC; Espace Partenaire" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                            <Label text="Gerez vos etablissements et lieux touristiques" style="-fx-text-fill: #666; -fx-font-size: 12;"/>
                        </VBox>
                        <HBox spacing="16">
                            <VBox spacing="4" style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                <Label text="&#x1F3E2; Mes Etablissements" style="-fx-text-fill: #888; -fx-font-size: 10;"/>
                                <Label fx:id="statEtabLabel" text="0" style="-fx-text-fill: #FFA726; -fx-font-size: 18; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="4" style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                <Label text="&#x1F30D; Mes Lieux" style="-fx-text-fill: #888; -fx-font-size: 10;"/>
                                <Label fx:id="statLieuxLabel" text="0" style="-fx-text-fill: #64B5F6; -fx-font-size: 18; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="4" style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                <Label text="&#x1F4B0; Reservations Cash" style="-fx-text-fill: #888; -fx-font-size: 10;"/>
                                <Label fx:id="statReservLabel" text="0 en attente" style="-fx-text-fill: #FFD700; -fx-font-size: 18; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="12">
                            <Label text="&#x1F4CA; Activite Recente" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
                            <VBox fx:id="recentActivityBox" spacing="8" style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 12; -fx-border-width: 1;">
                                <Label text="Aucune activite recente" style="-fx-text-fill: #666; -fx-font-size: 12;"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- PANEL GALERIE ETABLISSEMENTS -->
                <fx:include fx:id="panelGalerieEtab" source="etablissement_affichage.fxml" visible="false"/>
                <!-- PANEL GALERIE ACTIVITES -->
                <fx:include fx:id="panelGalerieActivite" source="activite_affichage.fxml" visible="false"/>
                <!-- PANEL TABLEAU ETABLISSEMENTS -->
                <fx:include fx:id="panelTableauEtab" source="etablissement_tableau.fxml" visible="false"/>
                <!-- PANEL TABLEAU ACTIVITES -->
                <fx:include fx:id="panelTableauActivite" source="activite_tableau.fxml" visible="false"/>
                <!-- PANEL LIEUX TOURISTIQUES -->
                <fx:include fx:id="panelLieuxTouristiques" source="LieuTouristiqueView.fxml" visible="false"/>
                <!-- PANEL ADRESSES -->
                <fx:include fx:id="panelAdresses" source="AdresseView.fxml" visible="false"/>
                <!-- PANEL CATEGORIES -->
                <fx:include fx:id="panelCategories" source="CategorieView.fxml" visible="false"/>

                <!-- PANEL RESERVATIONS CASH -->
                <ScrollPane fx:id="panelReservationsCash" fitToWidth="true" visible="false" style="-fx-background: #0a0a0a; -fx-background-color: #0a0a0a;" hbarPolicy="NEVER">
                    <VBox spacing="20" style="-fx-padding: 28;">
                        <VBox spacing="6">
                            <Label text="&#x1F4B0; Reservations Cash en Attente" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                            <Label text="Approuvez ou refusez les paiements en especes" style="-fx-text-fill: #666; -fx-font-size: 12;"/>
                        </VBox>
                        <VBox fx:id="cashReservationsBox" spacing="10"/>
                    </VBox>
                </ScrollPane>

                <!-- PANEL FORUM -->
                <fx:include fx:id="panelForum" source="forum/forum-main.fxml" visible="false"/>

                <!-- AI CHATBOT OVERLAY -->
                <VBox fx:id="chatBotPanel" visible="false" managed="false"
                      prefWidth="390" prefHeight="560" maxWidth="390" maxHeight="560"
                      StackPane.alignment="BOTTOM_RIGHT"
                      style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 20, 0.3, 0, 6);">
                    <StackPane.margin><Insets top="0" right="20" bottom="80" left="0"/></StackPane.margin>
                    <fx:include source="ChatBotView.fxml"/>
                </VBox>

                <!-- CHATBOT FAB BUTTON -->
                <Button fx:id="chatBotFab" text="&#x1F916;" onAction="#handleToggleChatBot"
                        styleClass="chatbot-fab" StackPane.alignment="BOTTOM_RIGHT"
                        mnemonicParsing="false">
                    <StackPane.margin><Insets top="0" right="24" bottom="16" left="0"/></StackPane.margin>
                    <tooltip><Tooltip text="Assistant IA"/></tooltip>
                </Button>
            </StackPane>

            <!-- ===== DRAWER OVERLAY ===== -->
            <Region fx:id="drawerOverlay" visible="false" onMouseClicked="#handleCloseDrawer"
                    style="-fx-background-color: rgba(0,0,0,0.5); -fx-cursor: hand;"/>

            <!-- ===== NAVIGATION DRAWER ===== -->
            <VBox fx:id="sidebarDrawer" spacing="0" StackPane.alignment="CENTER_LEFT" translateX="-280"
                  prefWidth="270" maxWidth="270"
                  style="-fx-background-color: rgba(8,8,8,0.99); -fx-border-color: rgba(255,215,0,0.08); -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 15, 0, 4, 0);">
                <!-- User Section -->
                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 28 20 16 20; -fx-background-color: rgba(255,165,0,0.03);">
                    <StackPane prefWidth="56" prefHeight="56" style="-fx-background-color: linear-gradient(to bottom right, rgba(255,165,0,0.2), rgba(255,140,0,0.1)); -fx-background-radius: 28;">
                        <Label fx:id="drawerInitials" text="P" style="-fx-text-fill: #FFA726; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="drawerUserName" text="Partenaire" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label fx:id="drawerUserRole" text="Partenaire" style="-fx-text-fill: #FFA726; -fx-font-size: 10;"/>
                </VBox>
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,165,0,0.12), transparent); -fx-pref-height: 1;"/>
                <!-- Nav Buttons -->
                <VBox spacing="3" style="-fx-padding: 16 12;" VBox.vgrow="ALWAYS">
                    <Label text="GESTION" style="-fx-text-fill: #444; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 0 0 8 8;"/>
                    <Button text="&#x1F3E0;  Accueil" onAction="#handleShowAccueil" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F5BC;  Galerie Etablissements" onAction="#handleShowGalerieEtab" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F3AD;  Galerie Activites" onAction="#handleShowGalerieActivite" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F3D6;  Gestion Lieux Touristiques" onAction="#handleShowLieuxTouristiques" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Region prefHeight="10"/>
                    <Label text="RESERVATIONS" style="-fx-text-fill: #444; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 0 0 8 8;"/>
                    <Button text="&#x1F4B0;  Reservations Cash" onAction="#handleShowReservationsCash" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Region prefHeight="10"/>
                    <Label text="CONFIGURATION" style="-fx-text-fill: #444; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 0 0 8 8;"/>
                    <Button text="&#x1F4C2;  Categories" onAction="#handleShowCategories" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F4CD;  Adresses" onAction="#handleShowAdresses" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F464;  Mon Profil" onAction="#handleShowProfil" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Region prefHeight="10"/>
                    <Label text="COMMUNAUT&#xC9;" style="-fx-text-fill: #444; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 0 0 8 8;"/>
                    <Button text="&#x1F4AC;  Forum" onAction="#handleShowForum" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="6" style="-fx-padding: 12;">
                    <Region style="-fx-background-color: rgba(255,255,255,0.03); -fx-pref-height: 1;"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

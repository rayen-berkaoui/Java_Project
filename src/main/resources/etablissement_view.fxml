<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.EtablissementController"
            stylesheets="@style.css"
            styleClass="app-root">

    <!-- TOP BAR -->
    <top>
        <VBox styleClass="topbar" spacing="0">
            <padding>
                <Insets top="20" right="28" bottom="18" left="28"/>
            </padding>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Gestion des établissements" styleClass="page-title"/>
                    <Label text="Vue détaillée avec formulaire intégré" styleClass="page-subtitle"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>                <Button text="&#x1F4C4; Exporter PDF" onAction="#onExportAllPdf" styleClass="btn-export-pdf"/>                <Button text="+ Nouveau" onAction="#onShowAjouter" styleClass="nav-tab"/>
                <Button text="↻ Rafraîchir" onAction="#onRefresh" styleClass="btn-secondary"/>
                <Region prefWidth="8"/>
                <Button text="☀" onAction="#toggleTheme" styleClass="theme-toggle-btn"/>
            </HBox>

            <Region prefHeight="12"/>

            <!-- Search & Filter toolbar -->
            <VBox styleClass="toolbar-container" spacing="0">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <HBox styleClass="search-container" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="0" right="4" bottom="0" left="12"/>
                        </padding>
                        <Label text="🔍" styleClass="search-icon"/>
                        <TextField fx:id="searchField"
                                   promptText="Rechercher par nom, ville, email, téléphone..."
                                   styleClass="search-field"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ComboBox fx:id="filterVille" prefWidth="140" promptText="Ville" styleClass="filter-combo"/>
                    <ComboBox fx:id="filterGamme" prefWidth="130" promptText="Gamme" styleClass="filter-combo"/>
                    <ComboBox fx:id="filterType" prefWidth="130" promptText="Type" styleClass="filter-combo"/>
                    <ComboBox fx:id="sortBox" prefWidth="130" promptText="Trier" styleClass="filter-combo"/>
                </HBox>
            </VBox>

            <Region prefHeight="12"/>
            <Region styleClass="accent-line-thin"/>
        </VBox>
    </top>

    <!-- LEFT FILTER PANEL -->
    <left>
        <VBox spacing="14" prefWidth="250" styleClass="sidepanel">
            <padding>
                <Insets top="20" right="18" bottom="20" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Region styleClass="gold-dot"/>
                <Label text="Filtres" styleClass="h2"/>
            </HBox>
            <Separator/>

            <Label text="Ville" styleClass="form-field-label"/>
            <ComboBox fx:id="filterVilleSide" promptText="Tous" styleClass="filter-combo" maxWidth="Infinity"/>

            <Label text="Gamme de prix" styleClass="form-field-label"/>
            <ComboBox fx:id="filterGammeSide" promptText="Tous" styleClass="filter-combo" maxWidth="Infinity"/>

            <Label text="Type" styleClass="form-field-label"/>
            <ComboBox fx:id="filterTypeSide" promptText="Tous" styleClass="filter-combo" maxWidth="Infinity"/>

            <Separator/>
            <Label text="Astuce" styleClass="section-title"/>
            <Label text="Utilise la barre de recherche pour filtrer rapidement."
                   wrapText="true" styleClass="muted"/>
        </VBox>
    </left>

    <!-- CENTER LIST -->
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="18" bottom="20" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Region styleClass="gold-dot"/>
                <Label text="Liste des établissements" styleClass="h1"/>
            </HBox>
            <ListView fx:id="etablissementList" VBox.vgrow="ALWAYS" styleClass="cards-list"/>
        </VBox>
    </center>

    <!-- RIGHT FORM -->
    <right>
        <VBox spacing="12" prefWidth="380" styleClass="formpanel">
            <padding>
                <Insets top="20" right="18" bottom="20" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Region styleClass="gold-dot"/>
                <Label text="Formulaire" styleClass="h2"/>
            </HBox>
            <Label fx:id="selectionInfoLabel" text="Aucune sélection" styleClass="muted"/>
            <Label fx:id="messageLabel" text="" wrapText="true"/>

            <Separator/>

            <TextField fx:id="nomField" promptText="Nom *" styleClass="form-input"/>
            <TextField fx:id="adresseField" promptText="Adresse" styleClass="form-input"/>
            <TextField fx:id="villeField" promptText="Ville *" styleClass="form-input"/>
            <TextField fx:id="telephoneField" promptText="Téléphone" styleClass="form-input"/>
            <TextField fx:id="emailField" promptText="Email" styleClass="form-input"/>
            <TextField fx:id="horairesField" promptText="Horaires" styleClass="form-input"/>
            <ComboBox fx:id="gammePrixField" promptText="Gamme (€ / €€ / €€€)" styleClass="form-combo" maxWidth="Infinity"/>

            <ComboBox fx:id="typeField" promptText="Type (hotel/restaurant/...)" styleClass="form-combo" maxWidth="Infinity"/>

            <TextArea fx:id="descriptionArea" promptText="Description (max 200)" prefRowCount="4" styleClass="form-textarea"/>

            <HBox spacing="10">
                <Button text="Ajouter" onAction="#onAjouter" styleClass="btn-primary" HBox.hgrow="ALWAYS"/>
                <Button text="Modifier" onAction="#onModifier" styleClass="btn-warning" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10">
                <Button text="Supprimer" onAction="#onSupprimer" styleClass="btn-danger" HBox.hgrow="ALWAYS"/>
                <Button text="Vider" onAction="#onVider" styleClass="btn-secondary" HBox.hgrow="ALWAYS"/>
            </HBox>

        </VBox>
    </right>

</BorderPane>
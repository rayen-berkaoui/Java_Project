<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.MainController"
            styleClass="root-pane"
            prefHeight="1080" prefWidth="1920">

    <top>
        <VBox spacing="0">
            <!-- Main Navigation Bar -->
            <HBox styleClass="nav-bar" prefHeight="72" alignment="CENTER_LEFT">
                <padding><Insets top="0" right="35" bottom="0" left="28"/></padding>

                <!-- Brand Logo -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="nav-brand">
                    <Label text="🗺️" style="-fx-font-size: 30px;"/>
                    <VBox spacing="0" alignment="CENTER_LEFT">
                        <Label styleClass="nav-title" text="GESTION"/>
                        <Label styleClass="nav-title-sub" text="TOURISTIQUE"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button styleClass="nav-button" text="�  Dashboard" onAction="#selectDashboardTab" prefHeight="42" minWidth="150"/>
                    <Button styleClass="nav-button" text="�📂  Catégories" onAction="#selectCategoriesTab" prefHeight="42" minWidth="150"/>
                    <Button styleClass="nav-button" text="📍  Adresses" onAction="#selectAddressesTab" prefHeight="42" minWidth="150"/>
                    <Button styleClass="nav-button" text="🏛️  Lieux" onAction="#selectLocationsTab" prefHeight="42" minWidth="150"/>                    <Button styleClass="nav-button" text="❤️  Favoris" onAction="#selectFavorisTab" prefHeight="42" minWidth="150"/>
                </HBox>

                <Region prefWidth="15"/>

                <!-- Language Toggle -->
                <HBox spacing="0" alignment="CENTER" styleClass="lang-toggle-group">
                    <Button fx:id="btnLangFr" text="FR" styleClass="lang-toggle-btn,lang-toggle-active" onAction="#switchToFrench" prefHeight="36" prefWidth="40"/>
                    <Button fx:id="btnLangEn" text="EN" styleClass="lang-toggle-btn" onAction="#switchToEnglish" prefHeight="36" prefWidth="40"/>
                    <Button fx:id="btnLangAr" text="ع" styleClass="lang-toggle-btn" onAction="#switchToArabic" prefHeight="36" prefWidth="40"/>                </HBox>

                <Region prefWidth="25"/>

                <Button styleClass="nav-button fullscreen-btn" text="⛶" onAction="#toggleFullScreen" prefHeight="42" prefWidth="48"/>
            </HBox>

            <!-- Gold accent line -->
            <Region styleClass="accent-line" prefHeight="3" maxHeight="3"/>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane" prefHeight="1010" prefWidth="1920">

            <Tab text="Dashboard" closable="false">
                <fx:include source="DashboardView.fxml"/>
            </Tab>

            <Tab text="Catégories" closable="false">
                <fx:include source="CategorieView.fxml"/>
            </Tab>

            <Tab text="Adresses" closable="false">
                <fx:include source="AdresseView.fxml"/>
            </Tab>

            <Tab text="Lieux Touristiques" closable="false">
                <fx:include source="LieuTouristiqueView.fxml"/>
            </Tab>

            <Tab text="Favoris" closable="false">
                <fx:include source="FavorisView.fxml"/>
            </Tab>

        </TabPane>
    </center>

</BorderPane>

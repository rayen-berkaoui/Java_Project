<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.LieuTouristiqueFormDialogController"
            styleClass="dialog-pane" prefWidth="920" prefHeight="620">
    <content>
        <VBox spacing="0" styleClass="dialog-content-root">

            <!-- Dialog Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dialog-header-section">
                <padding><Insets top="16" right="30" bottom="16" left="30"/></padding>
                <Label text="🏛️" style="-fx-font-size: 30px;"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Lieu Touristique" styleClass="dialog-page-title" style="-fx-font-size: 22px;"/>
                    <Label text="Définir les détails du lieu touristique" styleClass="dialog-page-subtitle"/>
                </VBox>
                <Button fx:id="btnFullscreen" text="⛶" styleClass="btn-fullscreen" mnemonicParsing="false"/>
            </HBox>

            <!-- Gold Separator -->
            <Region styleClass="accent-line" prefHeight="2" maxHeight="2"/>

            <!-- Form Content -->
            <HBox spacing="24" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

                <!-- Left Column -->
                <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section">
                    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
                    <Label text="ℹ️ Informations générales" styleClass="form-section-title" style="-fx-font-size: 15px;"/>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Nom" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfNom" promptText="Nom du lieu..." styleClass="form-input" prefHeight="40"/>
                        <Label fx:id="lblErrNom" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Description" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="tfDescription" promptText="Description détaillée..." styleClass="form-input" prefHeight="40" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnAiDesc" text="✨ IA" onAction="#generateAiDescription" styleClass="btn-ai-generate" prefHeight="40" mnemonicParsing="false">
                                <tooltip><Tooltip text="Générer une description avec l'IA Gemini"/></tooltip>
                            </Button>
                        </HBox>
                        <Label fx:id="lblErrDesc" text="" styleClass="error-label" visible="false" managed="false"/>
                        <Label fx:id="lblAiStatus" text="" style="-fx-text-fill: rgba(191,162,0,0.85); -fx-font-size: 10px;" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Ville" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfVille" promptText="Ville..." styleClass="form-input" prefHeight="40"/>
                        <Label fx:id="lblErrVille" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Prix (TND)" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfPrix" promptText="0.00" styleClass="form-input" prefHeight="40"/>
                        <Label fx:id="lblErrPrix" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>
                </VBox>

                <!-- Right Column -->
                <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section">
                    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
                    <Label text="🔗 Détails et médias" styleClass="form-section-title" style="-fx-font-size: 15px;"/>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Statut" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfStatut" promptText="1 = Actif, 0 = Inactif" styleClass="form-input" prefHeight="40"/>
                        <Label fx:id="lblErrStatut" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Catégorie" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <ComboBox fx:id="cbCategorie" promptText="Sélectionner une catégorie..." styleClass="form-combo" prefHeight="40" maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblErrCat" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Adresse" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                        <ComboBox fx:id="cbAdresse" promptText="Sélectionner une adresse..." styleClass="form-combo" prefHeight="40" maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblErrAdr" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <!-- Single Image Picker -->
                    <VBox spacing="8" styleClass="form-group">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🖼️ Image" styleClass="form-field-label" style="-fx-font-size: 12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnBrowseImage" text="Parcourir..." styleClass="btn-browse" style="-fx-font-size: 11px; -fx-padding: 4 14;"/>
                        </HBox>
                        <StackPane fx:id="imagePreviewPane" alignment="CENTER" styleClass="gallery-drop-zone" minHeight="120" prefHeight="140">
                            <Label fx:id="lblImageHint" text="📸 Aucune image sélectionnée" styleClass="gallery-drop-hint"/>
                            <ImageView fx:id="ivPreview" fitWidth="200" fitHeight="130" preserveRatio="true" visible="false"/>
                        </StackPane>
                        <Label fx:id="lblImagePath" text="" style="-fx-text-fill: rgba(191,162,0,0.6); -fx-font-size: 11px;" wrapText="true"/>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.FavorisController"
            fitToWidth="true" fitToHeight="true" styleClass="content-scroll" prefHeight="1010" prefWidth="1920">
    <VBox styleClass="content-root" VBox.vgrow="ALWAYS">
        <padding><Insets top="25" right="40" bottom="20" left="40"/></padding>

        <!-- Page Header -->
        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="page-header-banner">
            <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
            <VBox alignment="CENTER" styleClass="header-icon-badge">
                <Label text="❤️" styleClass="header-icon-emoji"/>
            </VBox>
            <VBox spacing="6" styleClass="header-title-block">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblHeaderTag" text="COLLECTION" styleClass="header-tag"/>
                </HBox>
                <Label fx:id="lblHeaderTitle" text="Mes Favoris" styleClass="header-main-title"/>
                <Label fx:id="lblHeaderDesc" text="Vos lieux touristiques préférés" styleClass="header-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" styleClass="header-stat-card">
                <Label fx:id="lblCount" text="--" styleClass="header-stat-number"/>
                <Label fx:id="lblCountLabel" text="Favoris" styleClass="header-stat-label"/>
                <Region styleClass="header-stat-underline" prefHeight="2" maxHeight="2"/>
            </VBox>
        </HBox>

        <Region styleClass="accent-line" prefHeight="2" maxHeight="2"/>

        <!-- Search Bar -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="action-bar">
            <padding><Insets top="10" right="0" bottom="5" left="0"/></padding>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="6" styleClass="search-container">
                <Label text="🔍" styleClass="search-icon"/>
                <TextField fx:id="searchField" promptText="Rechercher dans les favoris..." styleClass="search-field"/>
            </HBox>
        </HBox>

        <Region styleClass="accent-line-thin" prefHeight="1" maxHeight="1"/>

        <!-- Cards Grid -->
        <VBox VBox.vgrow="ALWAYS" alignment="CENTER" spacing="12">

            <HBox alignment="CENTER" spacing="15" VBox.vgrow="ALWAYS">
                <padding><Insets top="5" right="0" bottom="0" left="0"/></padding>

                <Button fx:id="btnPrev" text="◀" styleClass="carousel-arrow">
                    <tooltip><Tooltip text="Page précédente"/></tooltip>
                </Button>

                <HBox fx:id="cardsContainer" alignment="CENTER" spacing="18" HBox.hgrow="ALWAYS">
                </HBox>

                <Button fx:id="btnNext" text="▶" styleClass="carousel-arrow">
                    <tooltip><Tooltip text="Page suivante"/></tooltip>
                </Button>
            </HBox>

            <!-- Empty State -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false" styleClass="empty-state">
                <Label text="🤍" styleClass="empty-state-icon"/>
                <Label fx:id="lblEmptyTitle" text="Aucun favori" styleClass="empty-state-title"/>
                <Label fx:id="lblEmptySubtitle" text="Cliquez sur ❤️ sur un lieu pour l'ajouter à vos favoris" styleClass="empty-state-subtitle"/>
            </VBox>

            <HBox fx:id="pageIndicator" alignment="CENTER" spacing="8" styleClass="carousel-indicator-bar">
                <padding><Insets top="0" right="0" bottom="5" left="0"/></padding>
                <Label fx:id="lblPageInfo" text="" styleClass="carousel-page-info"/>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>

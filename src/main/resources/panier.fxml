<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.PanierController"
            prefWidth="1400" prefHeight="860"
            style="-fx-padding: 0; -fx-border-width: 0;"
            styleClass="root">

    <top>
        <VBox spacing="0">
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #080808; -fx-padding: 12 25;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: rgba(255,215,0,0.12); -fx-background-radius: 10;">
                        <Label text="&#x1F6D2;" style="-fx-font-size: 16;" />
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="MON PANIER" style="-fx-font-size: 16; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Label text="Gerez vos articles" style="-fx-font-size: 9; -fx-text-fill: #666666;" />
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="userNameLabel" text="Voyageur" style="-fx-text-fill: #FFD700; -fx-font-size: 12; -fx-font-weight: bold;" />
                <Region prefWidth="15" />
                <Button text="&#x1F3E0; Accueil" styleClass="dashboard-button" onAction="#handleBackToMain" style="-fx-padding: 8 16; -fx-font-size: 11;" />
                <Region prefWidth="8" />
                <Button text="&#x1F4B3; Mes Paiements" styleClass="dashboard-button" onAction="#handleGoToReservation" style="-fx-padding: 8 16; -fx-font-size: 11;" />
                <Region prefWidth="8" />
                <Button text="&#x1F6AA; Deconnexion" styleClass="dashboard-button-danger" onAction="#handleLogout" style="-fx-padding: 8 16; -fx-font-size: 11;" />
                <Region prefWidth="10" />
                <HBox spacing="2">
                    <Button text="&#x2014;" onAction="#handleMinimize" styleClass="window-button" />
                    <Button text="&#x2715;" onAction="#handleClose" styleClass="window-button-close" />
                </HBox>
            </HBox>
            <Region style="-fx-background-color: linear-gradient(to right, rgba(255,215,0,0.5), rgba(255,215,0,0.15), transparent); -fx-pref-height: 1.5;" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #0a0a0a; -fx-background-color: #0a0a0a;">
            <VBox spacing="24" style="-fx-padding: 30;">

                <!-- Stats -->
                <HBox spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="stat-card">
                        <Label text="&#x1F6D2;" style="-fx-font-size: 22;" />
                        <Label fx:id="totalItemsLabel" text="0" style="-fx-text-fill: #64B5F6; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <Label text="Articles" style="-fx-text-fill: #888; -fx-font-size: 11;" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="stat-card">
                        <Label text="&#x23F3;" style="-fx-font-size: 22;" />
                        <Label fx:id="enAttenteLabel" text="0" style="-fx-text-fill: #FFD700; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <Label text="En attente" style="-fx-text-fill: #888; -fx-font-size: 11;" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="stat-card">
                        <Label text="&#x1F4B0;" style="-fx-font-size: 22;" />
                        <Label fx:id="totalPrixLabel" text="0.00 DT" style="-fx-text-fill: #51CF66; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <Label text="Total estime" style="-fx-text-fill: #888; -fx-font-size: 11;" />
                    </VBox>
                </HBox>

                <Label fx:id="messageLabel" text="" style="-fx-font-size: 12;" />

                <!-- Carousel -->
                <VBox spacing="14" style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="&#x1F6D2; Mes Articles" style="-fx-font-size: 15; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="&#x25C0;" onAction="#handlePrev" styleClass="sidebar-button" style="-fx-padding: 6 14;" />
                        <Label fx:id="pageLabel" text="1 / 1" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                        <Button text="&#x25B6;" onAction="#handleNext" styleClass="sidebar-button" style="-fx-padding: 6 14;" />
                    </HBox>
                    <HBox fx:id="panierCarousel" spacing="16" style="-fx-min-height: 220;" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

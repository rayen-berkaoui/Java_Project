<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.PanierController"
            prefWidth="1400" prefHeight="860"
            style="-fx-background-color: #0a0a0a; -fx-padding: 0; -fx-border-width: 0;"
            styleClass="root">

    <!--  TOP BAR  UNIFIED HEADER  -->
    <top>
        <VBox spacing="0">
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: #080808; -fx-padding: 12 25;">

                <Button fx:id="menuToggleBtn" text="&#x2630;" onAction="#handleToggleDrawer" style="-fx-background-color: transparent; -fx-text-fill: #FFD700; -fx-font-size: 20; -fx-padding: 4 12; -fx-cursor: hand;" mnemonicParsing="false"/>
                <Region prefWidth="8"/>
                <!-- Brand -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane prefWidth="36" prefHeight="36"
                               style="-fx-background-color: rgba(255,215,0,0.12); -fx-background-radius: 10;">
                        <Label text="&#x1F30D;" style="-fx-font-size: 16;" />
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="TABAANI" style="-fx-font-size: 16; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Label text="SMARTTRAVEL" style="-fx-font-size: 9; -fx-text-fill: #666666;" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Panier Icon with badge -->
                <StackPane style="-fx-cursor: hand;">
                    <Label text="&#x1F6D2;" style="-fx-font-size: 18;" />
                    <StackPane fx:id="panierBadge" alignment="TOP_RIGHT" translateX="10" translateY="-5" visible="false">
                        <Label fx:id="panierCountLabel" text="0" style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 1 5; -fx-background-radius: 10;" />
                    </StackPane>
                </StackPane>

                <Region prefWidth="12" />

                <!-- User badge pill -->
                <HBox spacing="8" alignment="CENTER"
                      style="-fx-background-color: rgba(255,215,0,0.05); -fx-padding: 6 16; -fx-background-radius: 20;">
                    <StackPane prefWidth="26" prefHeight="26"
                               style="-fx-background-color: rgba(255,215,0,0.15); -fx-background-radius: 13;">
                        <Label text="&#x1F464;" style="-fx-font-size: 11;" />
                    </StackPane>
                    <Label fx:id="userNameLabel" text="Voyageur" style="-fx-text-fill: #FFD700; -fx-font-size: 12; -fx-font-weight: bold;" />
                </HBox>

                <Region prefWidth="12" />

                <!-- Nav buttons -->
                <HBox spacing="8" alignment="CENTER">
                    <Button text="&#x1F3E0; Accueil" styleClass="dashboard-button" onAction="#handleBackToMain"
                            style="-fx-padding: 8 16; -fx-font-size: 11;" />
                    <Button text="&#x1F6AA; Deconnexion" styleClass="dashboard-button-danger" onAction="#handleLogout"
                            style="-fx-padding: 8 16; -fx-font-size: 11;" />
                </HBox>

                <Region prefWidth="10" />

                <HBox spacing="2">
                    <Button text="&#x2014;" onAction="#handleMinimize" styleClass="window-button" />
                    <Button fx:id="fullscreenBtn" text="&#x26F6;" onAction="#handleToggleFullscreen" styleClass="window-button" />
                    <Button text="&#x2715;" onAction="#handleClose" styleClass="window-button-close" />
                </HBox>
            </HBox>

            <Region style="-fx-background-color: linear-gradient(to right, rgba(255,215,0,0.5), rgba(255,215,0,0.15), rgba(255,215,0,0.02), transparent); -fx-pref-height: 1.5;" />
        </VBox>
    </top>

    <!--  CENTER  -->
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background: #0a0a0a; -fx-background-color: #0a0a0a; -fx-padding: 0;">
            <VBox spacing="24" style="-fx-padding: 30;">

                <!-- Page Header -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="3">
                        <Label text="&#x1F6D2; Mon Panier" style="-fx-font-size: 22; -fx-text-fill: #ffffff; -fx-font-weight: bold;" />
                        <Label text="Gerez vos articles et confirmez vos reservations" style="-fx-text-fill: #666666; -fx-font-size: 12;" />
                    </VBox>
                </HBox>

                <!-- Stats Cards Row -->
                <HBox spacing="14">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane prefWidth="38" prefHeight="38"
                                       style="-fx-background-color: rgba(100,181,246,0.1); -fx-background-radius: 10;">
                                <Label text="&#x1F6D2;" style="-fx-font-size: 16;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Articles" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                <Label fx:id="totalItemsLabel" text="0" style="-fx-font-size: 22; -fx-text-fill: #64B5F6; -fx-font-weight: bold;" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane prefWidth="38" prefHeight="38"
                                       style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 10;">
                                <Label text="&#x23F3;" style="-fx-font-size: 16;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="En Attente" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                <Label fx:id="enAttenteLabel" text="0" style="-fx-font-size: 22; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 22; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane prefWidth="38" prefHeight="38"
                                       style="-fx-background-color: rgba(81,207,102,0.1); -fx-background-radius: 10;">
                                <Label text="&#x1F4B0;" style="-fx-font-size: 16;" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Total Estime" style="-fx-text-fill: #888888; -fx-font-size: 11;" />
                                <Label fx:id="totalPrixLabel" text="0.00 DT" style="-fx-font-size: 22; -fx-text-fill: #51CF66; -fx-font-weight: bold;" />
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Promo Code Section -->
                <HBox spacing="12" alignment="CENTER"
                      style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 18 24; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.08); -fx-border-radius: 14; -fx-border-width: 1;">
                    <StackPane prefWidth="38" prefHeight="38"
                               style="-fx-background-color: rgba(255,215,0,0.1); -fx-background-radius: 10;">
                        <Label text="&#x1F389;" style="-fx-font-size: 16;" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Code Promotionnel" style="-fx-text-fill: #FFD700; -fx-font-size: 13; -fx-font-weight: bold;" />
                        <Label text="Entrez un code pour beneficier de reductions exclusives" style="-fx-text-fill: #666; -fx-font-size: 10;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="&#x1F3F7; Appliquer un Code" styleClass="dashboard-button" onAction="#handleApplyPromo"
                            style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: linear-gradient(to right, rgba(255,215,0,0.15), rgba(255,140,0,0.15)); -fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
                </HBox>

                <!-- Message -->
                <Label fx:id="messageLabel" text="" style="-fx-font-size: 12; -fx-text-fill: #51CF66;" />

                <!-- Carousel Section -->
                <VBox spacing="16"
                      style="-fx-background-color: rgba(15,15,15,0.95); -fx-padding: 24; -fx-background-radius: 14; -fx-border-color: rgba(255,215,0,0.06); -fx-border-radius: 14; -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="&#x1F6D2; Mes Articles" style="-fx-font-size: 15; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="8" alignment="CENTER">
                            <Button text="&#x25C0;" styleClass="dashboard-button" onAction="#handlePrev"
                                    style="-fx-padding: 6 14; -fx-font-size: 13;" />
                            <Label fx:id="pageLabel" text="1 / 1" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                            <Button text="&#x25B6;" styleClass="dashboard-button" onAction="#handleNext"
                                    style="-fx-padding: 6 14; -fx-font-size: 13;" />
                        </HBox>
                    </HBox>

                    <HBox fx:id="panierCarousel" spacing="16" alignment="CENTER_LEFT"
                          style="-fx-padding: 6 0; -fx-min-height: 220;" />

                </VBox>

            </VBox>
        </ScrollPane>

            <!-- ===== DRAWER OVERLAY ===== -->
            <Region fx:id="drawerOverlay" visible="false" onMouseClicked="#handleCloseDrawer"
                    style="-fx-background-color: rgba(0,0,0,0.5); -fx-cursor: hand;"/>

            <!-- ===== NAVIGATION DRAWER ===== -->
            <VBox fx:id="sidebarDrawer" spacing="0" StackPane.alignment="CENTER_LEFT" translateX="-280"
                  prefWidth="270" maxWidth="270"
                  style="-fx-background-color: rgba(8,8,8,0.99); -fx-border-color: rgba(255,215,0,0.08); -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 15, 0, 4, 0);">
                <!-- User Section -->
                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 28 20 16 20; -fx-background-color: rgba(255,215,0,0.03);">
                    <StackPane prefWidth="56" prefHeight="56" style="-fx-background-color: linear-gradient(to bottom right, rgba(255,215,0,0.2), rgba(255,140,0,0.1)); -fx-background-radius: 28;">
                        <Label fx:id="drawerInitials" text="U" style="-fx-text-fill: #FFD700; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="drawerUserName" text="Voyageur" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label fx:id="drawerUserRole" text="Membre" style="-fx-text-fill: #888; -fx-font-size: 10;"/>
                </VBox>
                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.12), transparent); -fx-pref-height: 1;"/>
                <!-- Nav Buttons -->
                <VBox spacing="3" style="-fx-padding: 16 12;" VBox.vgrow="ALWAYS">
                    <Label text="NAVIGATION" style="-fx-text-fill: #444; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 0 0 8 8;"/>
                    <Button text="&#x1F3E0;  Accueil" onAction="#handleBackToMain" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F6D2;  Mon Panier" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button-active" disable="true"/>
                    <Button text="&#x1F4B3;  Mes Paiements" onAction="#handleGoToReservation" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Region prefHeight="10"/>
                    <Label text="COMPTE" style="-fx-text-fill: #444; -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 0 0 8 8;"/>
                    <Button text="&#x1F464;  Mon Profil" onAction="#handleBackToMain" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Button text="&#x1F6AA;  Deconnexion" onAction="#handleLogout" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="sidebar-button"/>
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
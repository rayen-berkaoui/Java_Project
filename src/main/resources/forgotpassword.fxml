<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.ForgotPasswordController"
            prefWidth="1100.0"
            prefHeight="650.0"
            style="-fx-background-color: #000000; -fx-border-width: 0; -fx-padding: 0; -fx-background-insets: 0;"
            styleClass="root">

    <!-- Custom Title Bar -->
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" spacing="0"
              style="-fx-background-color: #060606; -fx-padding: 6 12; -fx-border-color: transparent transparent rgba(255,215,0,0.06) transparent; -fx-border-width: 0 0 1 0;">
            <Label text="TABAANI" style="-fx-text-fill: rgba(255,215,0,0.6); -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 0 8;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="—" onAction="#handleMinimize" styleClass="window-button" />
            <Button text="✕" onAction="#handleClose" styleClass="window-button-close" />
        </HBox>
    </top>

    <center>
        <HBox spacing="0">

            <!-- ═══════ LEFT BRAND PANEL ═══════ -->
            <VBox alignment="CENTER" spacing="0" styleClass="brand-panel"
                  style="-fx-min-width: 400; -fx-max-width: 420;">

                <VBox alignment="CENTER" spacing="24" style="-fx-padding: 50 40;">

                    <!-- Brand icon -->
                    <StackPane prefWidth="110" prefHeight="110" maxWidth="110" maxHeight="110">
                        <Circle radius="50" style="-fx-fill: transparent; -fx-stroke: rgba(255,215,0,0.2); -fx-stroke-width: 1.5; -fx-stroke-dash-array: 6 4;" />
                        <Circle radius="38" style="-fx-fill: rgba(255,215,0,0.04);" />
                        <Label text="🔑" style="-fx-font-size: 36;" />
                    </StackPane>

                    <VBox alignment="CENTER" spacing="8">
                        <Label text="Récupération"
                               style="-fx-font-size: 30; -fx-text-fill: #FFD700; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.2), 15, 0.4, 0, 0);" />
                        <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.3), transparent); -fx-pref-height: 1; -fx-max-width: 160;" />
                        <Label text="Réinitialisez votre mot de passe en 3 étapes simples"
                               style="-fx-text-fill: #777777; -fx-font-size: 12;"
                               wrapText="true" textAlignment="CENTER" maxWidth="280" />
                    </VBox>

                    <Region prefHeight="20" />

                    <!-- Visual step progress -->
                    <VBox spacing="0" alignment="CENTER" style="-fx-padding: 0 30;">

                        <!-- Step 1 -->
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane prefWidth="36" prefHeight="36" minWidth="36"
                                       style="-fx-background-color: rgba(255,215,0,0.15); -fx-background-radius: 50; -fx-border-color: rgba(255,215,0,0.4); -fx-border-radius: 50; -fx-border-width: 1.5;">
                                <Label text="1" style="-fx-text-fill: #FFD700; -fx-font-size: 14; -fx-font-weight: bold;" />
                            </StackPane>
                            <VBox spacing="1">
                                <Label text="Saisir votre email" style="-fx-text-fill: #cccccc; -fx-font-size: 12; -fx-font-weight: bold;" />
                                <Label text="Nous vous enverrons un code" style="-fx-text-fill: #555555; -fx-font-size: 10;" />
                            </VBox>
                        </HBox>

                        <!-- Connector -->
                        <Region style="-fx-background-color: rgba(255,215,0,0.15); -fx-pref-width: 2; -fx-pref-height: 20; -fx-margin: 0 0 0 17;" />

                        <!-- Step 2 -->
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane prefWidth="36" prefHeight="36" minWidth="36"
                                       style="-fx-background-color: rgba(255,215,0,0.08); -fx-background-radius: 50; -fx-border-color: rgba(255,215,0,0.2); -fx-border-radius: 50; -fx-border-width: 1;">
                                <Label text="2" style="-fx-text-fill: rgba(255,215,0,0.6); -fx-font-size: 14; -fx-font-weight: bold;" />
                            </StackPane>
                            <VBox spacing="1">
                                <Label text="Vérifier le code OTP" style="-fx-text-fill: #999999; -fx-font-size: 12; -fx-font-weight: bold;" />
                                <Label text="Code à 6 chiffres" style="-fx-text-fill: #444444; -fx-font-size: 10;" />
                            </VBox>
                        </HBox>

                        <!-- Connector -->
                        <Region style="-fx-background-color: rgba(255,215,0,0.08); -fx-pref-width: 2; -fx-pref-height: 20;" />

                        <!-- Step 3 -->
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane prefWidth="36" prefHeight="36" minWidth="36"
                                       style="-fx-background-color: rgba(255,215,0,0.05); -fx-background-radius: 50; -fx-border-color: rgba(255,215,0,0.12); -fx-border-radius: 50; -fx-border-width: 1;">
                                <Label text="3" style="-fx-text-fill: rgba(255,215,0,0.4); -fx-font-size: 14; -fx-font-weight: bold;" />
                            </StackPane>
                            <VBox spacing="1">
                                <Label text="Nouveau mot de passe" style="-fx-text-fill: #666666; -fx-font-size: 12; -fx-font-weight: bold;" />
                                <Label text="Créez un mot de passe sécurisé" style="-fx-text-fill: #333333; -fx-font-size: 10;" />
                            </VBox>
                        </HBox>

                    </VBox>

                </VBox>

                <Region style="-fx-background-color: linear-gradient(to right, transparent, rgba(255,215,0,0.12), transparent); -fx-pref-height: 1;" />
            </VBox>

            <!-- Vertical separator -->
            <Region style="-fx-background-color: linear-gradient(to bottom, transparent 5%, rgba(255,215,0,0.2) 30%, rgba(255,215,0,0.08) 70%, transparent 95%); -fx-pref-width: 1; -fx-min-width: 1;" />

            <!-- ═══════ RIGHT FORM PANEL ═══════ -->
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #000000;">

                <VBox styleClass="login-card" alignment="TOP_CENTER" spacing="18" maxWidth="440"
                      style="-fx-padding: 35 40; -fx-background-color: transparent; -fx-border-color: transparent;">

                    <!-- ========================================= -->
                    <!-- STEP 1: Email Input                       -->
                    <!-- ========================================= -->
                    <VBox fx:id="step1Pane" alignment="TOP_CENTER" spacing="20" managed="true" visible="true">

                        <VBox alignment="CENTER" spacing="8" styleClass="header-section">
                            <Label text="🔑" styleClass="login-icon" />
                            <Label text="MOT DE PASSE OUBLIÉ" styleClass="login-title" style="-fx-font-size: 22px;" />
                            <Label text="Entrez votre adresse email pour recevoir un code de vérification"
                                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER" style="-fx-max-width: 360;" />
                        </VBox>

                        <Region styleClass="divider" prefHeight="1" maxWidth="250" />

                        <VBox spacing="6" styleClass="input-section">
                            <Label text="ADRESSE EMAIL" styleClass="field-label" />
                            <TextField fx:id="emailField" promptText="exemple@email.com" styleClass="text-field-modern" prefHeight="48" />
                        </VBox>

                        <Button text="ENVOYER LE CODE  ›" styleClass="login-button-modern"
                                prefHeight="50" prefWidth="280" onAction="#handleSendOTP" />

                        <Label fx:id="step1StatusLabel" styleClass="error-label-modern" wrapText="true" textAlignment="CENTER" />

                        <Region styleClass="divider" prefHeight="1" maxWidth="250" />

                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Retour à la" styleClass="footer-text" />
                            <Hyperlink text="page de connexion" styleClass="hyperlink-modern" onAction="#handleBackToLogin" />
                        </HBox>
                    </VBox>

                    <!-- ========================================= -->
                    <!-- STEP 2: OTP Verification                  -->
                    <!-- ========================================= -->
                    <VBox fx:id="step2Pane" alignment="TOP_CENTER" spacing="20" managed="false" visible="false">

                        <VBox alignment="CENTER" spacing="8" styleClass="header-section">
                            <Label text="📨" styleClass="login-icon" />
                            <Label text="VÉRIFICATION" styleClass="login-title" style="-fx-font-size: 22px;" />
                            <Label fx:id="otpInfoLabel" text="Un code a été envoyé à votre email"
                                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER" style="-fx-max-width: 360;" />
                        </VBox>

                        <Region styleClass="divider" prefHeight="1" maxWidth="250" />

                        <VBox spacing="6" styleClass="input-section">
                            <Label text="CODE DE VÉRIFICATION" styleClass="field-label" />
                            <TextField fx:id="otpField" promptText="000000" styleClass="text-field-modern" prefHeight="52"
                                       style="-fx-font-size: 24px; -fx-alignment: center;" />
                        </VBox>

                        <!-- Timer with visual indicator -->
                        <HBox alignment="CENTER" spacing="10"
                              style="-fx-background-color: rgba(255,215,0,0.05); -fx-padding: 10 20; -fx-background-radius: 10;">
                            <Label text="⏱" style="-fx-font-size: 16px;" />
                            <Label fx:id="timerLabel" text="60s restantes"
                                   style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        </HBox>

                        <Button fx:id="verifyButton" text="VÉRIFIER LE CODE  ›" styleClass="login-button-modern"
                                prefHeight="50" prefWidth="280" onAction="#handleVerifyOTP" />

                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Code non reçu ?" styleClass="footer-text" />
                            <Hyperlink fx:id="resendLink" text="Renvoyer le code" styleClass="hyperlink-modern" onAction="#handleResendOTP" />
                        </HBox>

                        <Label fx:id="step2StatusLabel" styleClass="error-label-modern" wrapText="true" textAlignment="CENTER" />

                        <Region styleClass="divider" prefHeight="1" maxWidth="250" />

                        <HBox alignment="CENTER" spacing="5">
                            <Hyperlink text="← Retour" styleClass="hyperlink-modern" onAction="#handleBackToStep1" />
                        </HBox>
                    </VBox>

                    <!-- ========================================= -->
                    <!-- STEP 3: New Password                      -->
                    <!-- ========================================= -->
                    <VBox fx:id="step3Pane" alignment="TOP_CENTER" spacing="20" managed="false" visible="false">

                        <VBox alignment="CENTER" spacing="8" styleClass="header-section">
                            <Label text="🔒" styleClass="login-icon" />
                            <Label text="NOUVEAU MOT DE PASSE" styleClass="login-title" style="-fx-font-size: 22px;" />
                            <Label text="Créez un nouveau mot de passe sécurisé pour votre compte"
                                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER" style="-fx-max-width: 360;" />
                        </VBox>

                        <Region styleClass="divider" prefHeight="1" maxWidth="250" />

                        <!-- New Password -->
                        <VBox spacing="6" styleClass="input-section">
                            <Label text="NOUVEAU MOT DE PASSE" styleClass="field-label" />
                            <StackPane>
                                <PasswordField fx:id="newPasswordField" promptText="Entrez le nouveau mot de passe"
                                               styleClass="text-field-modern" prefHeight="48" style="-fx-padding: 14 45 14 16;" />
                                <TextField fx:id="visibleNewPasswordField" promptText="Entrez le nouveau mot de passe"
                                           styleClass="text-field-modern" prefHeight="48" style="-fx-padding: 14 45 14 16;"
                                           managed="false" visible="false" />
                                <Button fx:id="toggleNewPwdButton" text="👁" onAction="#handleToggleNewPassword"
                                        styleClass="eye-button" StackPane.alignment="CENTER_RIGHT" />
                            </StackPane>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="6" styleClass="input-section">
                            <Label text="CONFIRMER LE MOT DE PASSE" styleClass="field-label" />
                            <StackPane>
                                <PasswordField fx:id="confirmPasswordField" promptText="Confirmez le nouveau mot de passe"
                                               styleClass="text-field-modern" prefHeight="48" style="-fx-padding: 14 45 14 16;" />
                                <TextField fx:id="visibleConfirmPasswordField" promptText="Confirmez le nouveau mot de passe"
                                           styleClass="text-field-modern" prefHeight="48" style="-fx-padding: 14 45 14 16;"
                                           managed="false" visible="false" />
                                <Button fx:id="toggleConfirmPwdButton" text="👁" onAction="#handleToggleConfirmPassword"
                                        styleClass="eye-button" StackPane.alignment="CENTER_RIGHT" />
                            </StackPane>
                        </VBox>

                        <Button text="RÉINITIALISER  ›" styleClass="login-button-modern"
                                prefHeight="50" prefWidth="280" onAction="#handleResetPassword" />

                        <Label fx:id="step3StatusLabel" styleClass="error-label-modern" wrapText="true" textAlignment="CENTER" />
                    </VBox>

                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>

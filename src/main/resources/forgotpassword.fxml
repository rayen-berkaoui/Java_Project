<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.ForgotPasswordController"
            prefWidth="1000.0"
            prefHeight="600.0"
            style="-fx-background-color: #000000; -fx-border-width: 0; -fx-padding: 0; -fx-background-insets: 0;"
            styleClass="root">

    <!-- Custom Title Bar -->
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" spacing="0"
              style="-fx-background-color: #0a0a0a; -fx-padding: 5 10;">
            <Region HBox.hgrow="ALWAYS" />
            <Button text="—" onAction="#handleMinimize" styleClass="window-button" />
            <Button text="✕" onAction="#handleClose" styleClass="window-button-close" />
        </HBox>
    </top>

    <center>
        <StackPane>

            <!-- Background -->
            <Region styleClass="gradient-background"
                    StackPane.alignment="CENTER"/>

            <!-- Main Card -->
            <VBox alignment="CENTER" styleClass="form-container">

                <VBox styleClass="login-card"
                      alignment="TOP_CENTER"
                      spacing="18">

                    <!-- ========================================= -->
                    <!-- STEP 1: Email Input                       -->
                    <!-- ========================================= -->
                    <VBox fx:id="step1Pane" alignment="TOP_CENTER" spacing="18" managed="true" visible="true">

                        <!-- Header -->
                        <VBox alignment="CENTER" spacing="10" styleClass="header-section">
                            <Label text="🔑" styleClass="login-icon"/>
                            <Label text="MOT DE PASSE OUBLIÉ" styleClass="login-title"
                                   style="-fx-font-size: 22px;"/>
                            <Label text="Entrez votre adresse email pour recevoir un code de vérification"
                                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER"
                                   style="-fx-max-width: 380;"/>
                        </VBox>

                        <Region styleClass="divider" prefHeight="1"/>

                        <!-- Email Input -->
                        <VBox spacing="6" styleClass="input-section">
                            <Label text="Adresse Email" styleClass="field-label"/>
                            <TextField fx:id="emailField"
                                       promptText="exemple@email.com"
                                       styleClass="text-field-modern"
                                       prefHeight="48"/>
                        </VBox>

                        <!-- Send OTP Button -->
                        <Button text="ENVOYER LE CODE"
                                styleClass="login-button-modern"
                                prefHeight="50" prefWidth="250"
                                onAction="#handleSendOTP"/>

                        <!-- Status Label -->
                        <Label fx:id="step1StatusLabel"
                               styleClass="error-label-modern"
                               wrapText="true" textAlignment="CENTER"/>

                        <Region styleClass="divider" prefHeight="1"/>

                        <!-- Back to login -->
                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Retour à la" styleClass="footer-text"/>
                            <Hyperlink text="page de connexion"
                                       styleClass="hyperlink-modern"
                                       onAction="#handleBackToLogin"/>
                        </HBox>
                    </VBox>

                    <!-- ========================================= -->
                    <!-- STEP 2: OTP Verification                  -->
                    <!-- ========================================= -->
                    <VBox fx:id="step2Pane" alignment="TOP_CENTER" spacing="18" managed="false" visible="false">

                        <!-- Header -->
                        <VBox alignment="CENTER" spacing="10" styleClass="header-section">
                            <Label text="📨" styleClass="login-icon"/>
                            <Label text="VÉRIFICATION" styleClass="login-title"
                                   style="-fx-font-size: 22px;"/>
                            <Label fx:id="otpInfoLabel"
                                   text="Un code a été envoyé à votre email"
                                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER"
                                   style="-fx-max-width: 380;"/>
                        </VBox>

                        <Region styleClass="divider" prefHeight="1"/>

                        <!-- OTP Code Input -->
                        <VBox spacing="6" styleClass="input-section">
                            <Label text="Code de vérification (6 chiffres)" styleClass="field-label"/>
                            <TextField fx:id="otpField"
                                       promptText="000000"
                                       styleClass="text-field-modern"
                                       prefHeight="48"
                                       style="-fx-font-size: 22px; -fx-alignment: center; -fx-letter-spacing: 8px;"/>
                        </VBox>

                        <!-- Timer -->
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="⏱" style="-fx-font-size: 16px;"/>
                            <Label fx:id="timerLabel"
                                   text="60s restantes"
                                   style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Verify Button -->
                        <Button fx:id="verifyButton"
                                text="VÉRIFIER LE CODE"
                                styleClass="login-button-modern"
                                prefHeight="50" prefWidth="250"
                                onAction="#handleVerifyOTP"/>

                        <!-- Resend -->
                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Code non reçu ?" styleClass="footer-text"/>
                            <Hyperlink fx:id="resendLink"
                                       text="Renvoyer le code"
                                       styleClass="hyperlink-modern"
                                       onAction="#handleResendOTP"/>
                        </HBox>

                        <!-- Status Label -->
                        <Label fx:id="step2StatusLabel"
                               styleClass="error-label-modern"
                               wrapText="true" textAlignment="CENTER"/>

                        <Region styleClass="divider" prefHeight="1"/>

                        <!-- Back -->
                        <HBox alignment="CENTER" spacing="5">
                            <Hyperlink text="← Retour"
                                       styleClass="hyperlink-modern"
                                       onAction="#handleBackToStep1"/>
                        </HBox>
                    </VBox>

                    <!-- ========================================= -->
                    <!-- STEP 3: New Password                      -->
                    <!-- ========================================= -->
                    <VBox fx:id="step3Pane" alignment="TOP_CENTER" spacing="18" managed="false" visible="false">

                        <!-- Header -->
                        <VBox alignment="CENTER" spacing="10" styleClass="header-section">
                            <Label text="🔒" styleClass="login-icon"/>
                            <Label text="NOUVEAU MOT DE PASSE" styleClass="login-title"
                                   style="-fx-font-size: 22px;"/>
                            <Label text="Créez un nouveau mot de passe sécurisé pour votre compte"
                                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER"
                                   style="-fx-max-width: 380;"/>
                        </VBox>

                        <Region styleClass="divider" prefHeight="1"/>

                        <!-- New Password -->
                        <VBox spacing="6" styleClass="input-section">
                            <Label text="Nouveau mot de passe" styleClass="field-label"/>
                            <StackPane>
                                <PasswordField fx:id="newPasswordField"
                                               promptText="Entrez le nouveau mot de passe"
                                               styleClass="text-field-modern"
                                               prefHeight="48"
                                               style="-fx-padding: 14 45 14 16;"/>
                                <TextField fx:id="visibleNewPasswordField"
                                           promptText="Entrez le nouveau mot de passe"
                                           styleClass="text-field-modern"
                                           prefHeight="48"
                                           style="-fx-padding: 14 45 14 16;"
                                           managed="false" visible="false"/>
                                <Button fx:id="toggleNewPwdButton"
                                        text="👁" onAction="#handleToggleNewPassword"
                                        styleClass="eye-button"
                                        StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="6" styleClass="input-section">
                            <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                            <StackPane>
                                <PasswordField fx:id="confirmPasswordField"
                                               promptText="Confirmez le nouveau mot de passe"
                                               styleClass="text-field-modern"
                                               prefHeight="48"
                                               style="-fx-padding: 14 45 14 16;"/>
                                <TextField fx:id="visibleConfirmPasswordField"
                                           promptText="Confirmez le nouveau mot de passe"
                                           styleClass="text-field-modern"
                                           prefHeight="48"
                                           style="-fx-padding: 14 45 14 16;"
                                           managed="false" visible="false"/>
                                <Button fx:id="toggleConfirmPwdButton"
                                        text="👁" onAction="#handleToggleConfirmPassword"
                                        styleClass="eye-button"
                                        StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </VBox>

                        <!-- Reset Button -->
                        <Button text="RÉINITIALISER"
                                styleClass="login-button-modern"
                                prefHeight="50" prefWidth="250"
                                onAction="#handleResetPassword"/>

                        <!-- Status Label -->
                        <Label fx:id="step3StatusLabel"
                               styleClass="error-label-modern"
                               wrapText="true" textAlignment="CENTER"/>
                    </VBox>

                </VBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="0.0" minWidth="0.0" prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@forum-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.ForumAccueilController">
    <center>
        <VBox alignment="TOP_LEFT" spacing="0.0" VBox.vgrow="ALWAYS" BorderPane.alignment="CENTER">
            <children>
                <VBox styleClass="filter-bar" spacing="12.0" maxWidth="99999.0" VBox.vgrow="NEVER">
                    <padding>
                        <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="99999.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Recherche" />
                            <TextField fx:id="searchField" onKeyReleased="#applyFilters" promptText="Mots-clés..." minWidth="80.0" maxWidth="99999.0" styleClass="text-field" HBox.hgrow="ALWAYS" />
                            <Label styleClass="field-label" text="Hashtag(s)" />
                            <TextField fx:id="hashtagField" onKeyReleased="#applyFilters" promptText="tag1, tag2, tag3..." minWidth="80.0" maxWidth="99999.0" styleClass="text-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="99999.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Du" />
                            <DatePicker fx:id="dateFrom" onAction="#applyFilters" />
                            <Label styleClass="field-label" text="Au" />
                            <DatePicker fx:id="dateTo" onAction="#applyFilters" />
                            <Region HBox.hgrow="ALWAYS" minWidth="10.0" />
                            <Button mnemonicParsing="false" onAction="#applyFilters" styleClass="dashboard-button" text="Filtrer" />
                            <Button mnemonicParsing="false" onAction="#clearFilters" styleClass="dashboard-button" text="Effacer" />
                        </HBox>
                    </children>
                </VBox>
                <ListView fx:id="postsListView" styleClass="post-feed" minWidth="0.0" minHeight="0.0" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                    </VBox.margin>
                </ListView>
                <HBox styleClass="pagination-bar" alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
                    <padding>
                        <Insets bottom="16.0" left="20.0" right="20.0" top="12.0" />
                    </padding>
                    <children>
                        <Label fx:id="paginationInfoLabel" styleClass="pagination-info" text="Affichage 0-0 sur 0" />
                        <Region HBox.hgrow="ALWAYS" minWidth="10.0" />
                        <Label styleClass="field-label" text="Par page :" />
                        <ComboBox fx:id="pageSizeCombo" prefWidth="80.0" onAction="#onPageSizeChanged" />
                        <Region HBox.hgrow="NEVER" minWidth="20.0" />
                        <Button fx:id="btnPrevPage" mnemonicParsing="false" onAction="#goToPrevPage" styleClass="dashboard-button" text="← Précédent" />
                        <Label fx:id="pageIndicatorLabel" styleClass="pagination-page" text="Page 1 / 1" />
                        <Button fx:id="btnNextPage" mnemonicParsing="false" onAction="#goToNextPage" styleClass="dashboard-button" text="Suivant →" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>

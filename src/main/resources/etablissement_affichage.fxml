<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.esprit.controllers.AffichageEtablissementController"
           stylesheets="@style.css">
<BorderPane fx:id="rootPane" styleClass="app-root">

    <!-- CENTER CONTENT -->
    <center>
        <VBox styleClass="page-body">
            <padding>
                <Insets top="24" right="28" bottom="28" left="28"/>
            </padding>

            <!-- Inline Filters Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: rgba(18,18,18,0.95); -fx-padding: 12 18; -fx-background-radius: 10; -fx-border-color: rgba(255,215,0,0.08); -fx-border-radius: 10;">
                <TextField fx:id="searchField"
                           promptText="&#x1f50d; Nom, ville, email..."
                           styleClass="sidebar-search" prefWidth="200"/>
                <ComboBox fx:id="filterVille" promptText="Ville" styleClass="sidebar-combo" prefWidth="130"/>
                <ComboBox fx:id="filterGamme" promptText="Gamme" styleClass="sidebar-combo" prefWidth="130"/>
                <ComboBox fx:id="filterType" promptText="Type" styleClass="sidebar-combo" prefWidth="120"/>
                <ComboBox fx:id="sortBox" promptText="Trier par" styleClass="sidebar-combo" prefWidth="130"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nouveau" onAction="#onShowAjouter" styleClass="nav-tab" style="-fx-padding: 8 16;"/>
                <Button text="&#x21bb;" onAction="#onRefresh" styleClass="nav-tab" style="-fx-padding: 8 12;"/>
            </HBox>

            <Region prefHeight="14"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="&#x1f5bc;" style="-fx-font-size: 24px;"/>
                <Label text="Galerie Premium" styleClass="h1"/>
            </HBox>

            <Region prefHeight="18"/>

            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                        styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox alignment="CENTER" spacing="0" style="-fx-padding: 0;">

                        <!-- Carousel row: arrow + cards + arrow -->
                        <HBox alignment="CENTER" spacing="18" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets top="0" right="0" bottom="0" left="0"/>
                            </padding>

                            <Button fx:id="prevBtn" text="&#x276E;"
                                    onAction="#onPrev"
                                    styleClass="carousel-arrow"
                                    minWidth="48" minHeight="48"/>

                            <HBox fx:id="cardsRow" spacing="45" alignment="CENTER"
                                  HBox.hgrow="ALWAYS" style="-fx-padding: 8 0;"/>

                            <Button fx:id="nextBtn" text="&#x276F;"
                                    onAction="#onNext"
                                    styleClass="carousel-arrow"
                                    minWidth="48" minHeight="48"/>
                        </HBox>

                        <!-- Dots / Page indicator -->
                        <HBox fx:id="dotsBox" alignment="CENTER" spacing="10"
                              style="-fx-padding: 18 0 8 0;"/>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
</StackPane>
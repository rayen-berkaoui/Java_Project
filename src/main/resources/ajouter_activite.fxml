<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.AjouterActiviteController"
            stylesheets="@style.css"
            styleClass="app-root">

    <top>
        <VBox styleClass="topbar" spacing="10">
            <padding>
                <Insets top="18" right="22" bottom="16" left="22"/>
            </padding>
            <Label text="Ajouter / Modifier une activité" styleClass="page-title"/>
            <Region styleClass="accent-line-thin"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="content-root">
            <padding>
                <Insets top="18" right="22" bottom="22" left="22"/>
            </padding>

            <Label text="Nom" styleClass="field-label"/>
            <TextField fx:id="nomField" promptText="Nom de l’activité" />

            <Label text="Catégorie" styleClass="field-label"/>
            <ComboBox fx:id="categorieBox" promptText="Choisir catégorie"/>

            <Label text="Niveau" styleClass="field-label"/>
            <ComboBox fx:id="niveauBox" promptText="Choisir niveau"/>

            <Label text="Durée (minutes)" styleClass="field-label"/>
            <TextField fx:id="dureeField" promptText="Ex: 60"/>

            <Label text="Description" styleClass="field-label"/>
            <TextArea fx:id="descArea" promptText="Description..." prefRowCount="4"/>

            <!-- ✅ NEW -->
            <Label text="Image URL / Path" styleClass="field-label"/>
            <TextField fx:id="imageUrlField" promptText="https://... ou C:\...\image.jpg"/>

            <HBox spacing="10" styleClass="action-bar">
                <Button text="Enregistrer" onAction="#onSave" styleClass="btn-primary"/>
                <Button text="Annuler" onAction="#onCancel" styleClass="btn-secondary"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>

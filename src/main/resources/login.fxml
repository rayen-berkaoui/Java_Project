<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.LoginController"
            prefWidth="1000.0"
            prefHeight="600.0"
            style="-fx-background-color: #000000; -fx-border-width: 0; -fx-padding: 0; -fx-background-insets: 0;"
            styleClass="root">

    <!-- Custom Title Bar -->
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" spacing="0"
              style="-fx-background-color: #0a0a0a; -fx-padding: 5 10;">
            <Region HBox.hgrow="ALWAYS" />
            <Button text="—" onAction="#handleMinimize" styleClass="window-button" />
            <Button text="✕" onAction="#handleClose" styleClass="window-button-close" />
        </HBox>
    </top>

    <center>
        <StackPane>

            <!-- Background -->
            <Region styleClass="gradient-background"
                    StackPane.alignment="CENTER"/>

            <!-- Form Container -->
            <VBox fx:id="loginPane"
                  alignment="CENTER"
                  styleClass="form-container">

                <VBox styleClass="login-card"
                      alignment="TOP_CENTER"
                      spacing="20">

                    <!-- Header -->
                    <VBox alignment="CENTER"
                          spacing="12"
                          styleClass="header-section">

                        <Label text="🔐"
                               styleClass="login-icon"/>

                        <Label text="TABAANI"
                               styleClass="login-title"/>

                        <Label text="Bienvenue sur votre plateforme"
                               styleClass="login-subtitle"/>

                    </VBox>

                    <!-- Divider -->
                    <Region styleClass="divider" prefHeight="1"/>

                    <!-- Inputs -->
                    <VBox spacing="16"
                          styleClass="input-section">

                        <!-- Email -->
                        <VBox spacing="6">
                            <Label text="Adresse Email"
                                   styleClass="field-label"/>

                            <TextField fx:id="emailField"
                                       promptText="exemple@email.com"
                                       styleClass="text-field-modern"
                                       prefHeight="48"/>
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="6">
                            <Label text="Mot de passe"
                                   styleClass="field-label"/>

                            <StackPane>
                                <PasswordField fx:id="passwordField"
                                               promptText="Entrez votre mot de passe"
                                               styleClass="text-field-modern"
                                               prefHeight="48"
                                               style="-fx-padding: 14 45 14 16;"/>

                                <TextField fx:id="visiblePasswordField"
                                           promptText="Entrez votre mot de passe"
                                           styleClass="text-field-modern"
                                           prefHeight="48"
                                           style="-fx-padding: 14 45 14 16;"
                                           managed="false"
                                           visible="false"/>

                                <Button fx:id="togglePasswordButton"
                                        text="👁"
                                        onAction="#handleTogglePassword"
                                        styleClass="eye-button"
                                        StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </VBox>

                    </VBox>

                    <!-- Remember / Forgot -->
                    <HBox alignment="CENTER"
                          spacing="10">

                        <CheckBox text="Se souvenir de moi"
                                  styleClass="custom-checkbox"/>

                        <Hyperlink text="Mot de passe oublié?"
                                   styleClass="hyperlink-modern"
                                   onAction="#handleForgotPassword"/>

                    </HBox>

                    <!-- Login Button -->
                    <Button text="SE CONNECTER"
                            styleClass="login-button-modern"
                            prefHeight="50"
                            prefWidth="250"
                            onAction="#handleLogin"/>

                    <!-- Error Label -->
                    <Label fx:id="errorLabel"
                           styleClass="error-label-modern"
                           wrapText="true"
                           textAlignment="CENTER"/>

                    <!-- Divider -->
                    <Region styleClass="divider" prefHeight="1"/>

                    <!-- Footer -->
                    <HBox alignment="CENTER"
                          spacing="5">

                        <Label text="Vous n'avez pas de compte?"
                               styleClass="footer-text"/>

                        <!-- ✅ Navigation Added -->
                        <Hyperlink text="S'inscrire maintenant"
                                   styleClass="hyperlink-modern"
                                   onAction="#handleSignupLink"/>

                    </HBox>

                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
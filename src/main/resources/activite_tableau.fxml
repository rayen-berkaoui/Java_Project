<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.esprit.controllers.TableauActiviteController"
           stylesheets="@style.css"
           fx:id="rootStack">
<BorderPane styleClass="app-root">

    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" styleClass="content-scroll">
        <VBox styleClass="page-body">
            <padding>
                <Insets top="24" right="28" bottom="28" left="28"/>
            </padding>

            <!-- Inline toolbar -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: rgba(18,18,18,0.95); -fx-padding: 10 18; -fx-background-radius: 10; -fx-border-color: rgba(255,215,0,0.08); -fx-border-radius: 10;">
                <HBox styleClass="search-container" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="0" right="4" bottom="0" left="12"/>
                    </padding>
                    <Label text="&#x1f50d;" styleClass="search-icon"/>
                    <TextField fx:id="searchField"
                               promptText="Rechercher par nom, catégorie, niveau..."
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <ComboBox fx:id="filterCategorie" prefWidth="150" promptText="Catégorie" styleClass="filter-combo"/>
                <ComboBox fx:id="filterNiveau" prefWidth="140" promptText="Niveau" styleClass="filter-combo"/>
                <ComboBox fx:id="filterStatut" prefWidth="140" promptText="Statut" styleClass="filter-combo"/>
                <Button text="&#x1F4C4; PDF" onAction="#onExportAllPdf" styleClass="btn-export-pdf"/>
                <Button text="&#x1F4CA; Excel" onAction="#onExportExcel" styleClass="btn-export-pdf"/>
                <Button text="+ Nouvelle activité" onAction="#onShowAjouter" styleClass="nav-tab" style="-fx-padding: 8 14;"/>
                <Button text="&#x21bb;" onAction="#onRefresh" styleClass="btn-secondary"/>
            </HBox>

            <Region prefHeight="14"/>
            <padding>
                <Insets top="24" right="28" bottom="28" left="28"/>
            </padding>

            <!-- ════════ STATISTICS SECTION ════════ -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="&#x1f4ca;" style="-fx-font-size: 24px;"/>
                <Label text="Statistiques par" styleClass="h1"/>
                <ComboBox fx:id="chartFieldSelector" styleClass="filter-combo" prefWidth="200"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnToggleChart" text="&#x1f504; Changer de vue" onAction="#onToggleChart" styleClass="btn-secondary"/>
                <Button fx:id="btnToggleStats" text="&#x25b2; Masquer" onAction="#onToggleStats" styleClass="btn-secondary"/>
            </HBox>

            <Region prefHeight="12"/>

            <!-- Stats summary cards row -->
            <HBox fx:id="statsCardsRow" spacing="14" alignment="CENTER">
                <padding><Insets top="0" right="0" bottom="10" left="0"/></padding>
            </HBox>

            <!-- Charts container (toggle between pie/bar) -->
            <StackPane fx:id="chartsContainer" styleClass="stats-chart-container" minHeight="340" prefHeight="340">
                <PieChart fx:id="pieChart" title="R&#xe9;partition par Cat&#xe9;gorie" legendVisible="true"
                          labelsVisible="true" styleClass="stats-pie-chart"/>
                <BarChart fx:id="barChart" title="Nombre par Cat&#xe9;gorie" legendVisible="false"
                          styleClass="stats-bar-chart" visible="false">
                    <xAxis><CategoryAxis label="Cat&#xe9;gorie" fx:id="barXAxis"/></xAxis>
                    <yAxis><NumberAxis label="Nombre" fx:id="barYAxis"/></yAxis>
                </BarChart>
            </StackPane>

            <Region prefHeight="24"/>

            <!-- ════════ TABLE SECTION ════════ -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="&#x1f4cb;" style="-fx-font-size: 24px;"/>
                <Label text="Tableau des Activit&#xe9;s" styleClass="h1"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" styleClass="stats-count-label"/>
            </HBox>

            <Region prefHeight="18"/>

            <!-- Premium Table Container -->
            <VBox styleClass="premium-table-container">

                <!-- Table Header -->
                <HBox styleClass="table-header-row" alignment="CENTER_LEFT" spacing="0">
                    <Label text="NOM" styleClass="table-header-label" prefWidth="220" minWidth="220"/>
                    <Label text="CAT&#xc9;GORIE" styleClass="table-header-label" prefWidth="120" minWidth="120"/>
                    <Label text="NIVEAU" styleClass="table-header-label" prefWidth="120" minWidth="120"/>
                    <Label text="DUR&#xc9;E" styleClass="table-header-label" prefWidth="80" minWidth="80"/>
                    <Label text="PRIX" styleClass="table-header-label" prefWidth="100" minWidth="100"/>
                    <Label text="STATUT" styleClass="table-header-label" prefWidth="110" minWidth="110"/>
                    <Label text="PLACES" styleClass="table-header-label" prefWidth="80" minWidth="80"/>
                    <Label text="ACTIONS" styleClass="table-header-label" prefWidth="140" minWidth="140"/>
                </HBox>

                <!-- Table Body -->
                <VBox fx:id="tableBody"/>

            </VBox>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
</StackPane>

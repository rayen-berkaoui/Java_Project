<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.HomeController"
            stylesheets="@style.css"
            styleClass="app-root">

    <!-- TOP BAR -->
    <top>
        <VBox styleClass="topbar" spacing="10">
            <padding>
                <Insets top="18" right="22" bottom="16" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Premium Dashboard" styleClass="page-title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="Bienvenue 👋" styleClass="topbar-subtitle"/>
            </HBox>

            <Region styleClass="accent-line-thin"/>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <StackPane styleClass="page-body">
            <padding>
                <Insets top="18" right="22" bottom="22" left="22"/>
            </padding>

            <VBox alignment="CENTER" spacing="18" styleClass="home-card">
                <Label text="Choisissez un module" styleClass="home-title"/>
                <Label text="Accédez rapidement à la gestion des activités ou des établissements."
                       wrapText="true"
                       styleClass="home-subtitle"/>

                <HBox spacing="30" alignment="CENTER">

                    <Button text="🏃  Gestion des Activités"
                            onAction="#goActivites"
                            styleClass="btn-yellow"/>

                    <Button text="🏢  Gestion des Établissements"
                            onAction="#goEtablissements"
                            styleClass="btn-yellow"/>

                </HBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>

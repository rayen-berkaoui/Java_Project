<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane minHeight="600.0" minWidth="1000.0" prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="navbar" prefHeight="72.0" minHeight="72.0">
            <children>
                <Label styleClass="login-title" text="TABAANI" />
                <Button fx:id="backBtn" mnemonicParsing="false" onAction="#handleBack" styleClass="dashboard-button" text="← Retour" visible="false" managed="false" />
                <Region HBox.hgrow="ALWAYS" minWidth="0.0" />
                <HBox alignment="CENTER_RIGHT" spacing="16.0" minWidth="320.0">
                    <Button fx:id="adminBtn" mnemonicParsing="false" onAction="#handleAdmin" styleClass="dashboard-button" text="Administration" />
                    <Button fx:id="addPostBtn" mnemonicParsing="false" onAction="#handleAddPost" styleClass="dashboard-button" text="+ Nouvelle publication" />
                </HBox>
            </children>
            <padding>
                <Insets left="24.0" right="24.0" top="12.0" bottom="12.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
            </BorderPane.margin>
        </StackPane>
    </center>
</BorderPane>

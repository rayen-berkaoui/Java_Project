<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="400.0" minWidth="600.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.TabaaniConnectController">
    <center>
        <VBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
            <Label styleClass="login-title" text="TABAANI CONNECT" />
            <HBox alignment="CENTER" spacing="32.0">
                <VBox styleClass="connect-card" alignment="CENTER" spacing="16.0">
                    <minWidth>260.0</minWidth>
                    <prefWidth>260.0</prefWidth>
                    <prefHeight>200.0</prefHeight>
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 48;" text="📝" />
                        <Label styleClass="connect-card-title" text="Espace Postes" />
                        <Button mnemonicParsing="false" onAction="#openEspacePostes" styleClass="dashboard-button" text="Accéder" />
                    </children>
                </VBox>
                <VBox styleClass="connect-card" alignment="CENTER" spacing="16.0">
                    <minWidth>260.0</minWidth>
                    <prefWidth>260.0</prefWidth>
                    <prefHeight>200.0</prefHeight>
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 48;" text="💬" />
                        <Label styleClass="connect-card-title" text="Espace Chat" />
                        <Button mnemonicParsing="false" onAction="#openEspaceChat" styleClass="dashboard-button" text="Accéder" />
                    </children>
                </VBox>
            </HBox>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>

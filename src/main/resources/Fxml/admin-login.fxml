<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="320.0" prefWidth="400.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AdminLoginController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="navbar" prefHeight="72.0">
            <children>
                <Label styleClass="login-title" text="Administration · Connexion" />
            </children>
            <padding>
                <Insets left="24.0" right="24.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="16.0" BorderPane.alignment="CENTER">
            <Label styleClass="field-label" text="Identifiant" />
            <TextField fx:id="usernameField" promptText="Identifiant administrateur" styleClass="text-field" />
            <Label styleClass="field-label" text="Mot de passe" />
            <PasswordField fx:id="passwordField" promptText="Mot de passe" styleClass="text-field" />
            <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="dashboard-button" text="Connexion" />
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>

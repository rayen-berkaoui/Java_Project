<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="300.0" minWidth="500.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ChatPlaceholderController">
    <center>
        <VBox alignment="CENTER" spacing="24.0" BorderPane.alignment="CENTER">
            <Label style="-fx-font-size: 64;" text="💬" />
            <Label styleClass="connect-card-title" text="Espace Chat" />
            <Label style="-fx-text-fill: #888; -fx-font-size: 14;" text="DISCUSSION EN TEMPS RÉEL — WEBSOCKET" />
            <Label style="-fx-text-fill: #666; -fx-font-size: 12;" text="Prochaine étape : salon ouvert instantané" />
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="dashboard-button" text="← Retour à Tabaani Connect" />
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.ActiviteController"
            stylesheets="@style.css"
            styleClass="app-root">

    <top>
        <VBox styleClass="topbar" spacing="12">
            <padding>
                <Insets top="18" right="22" bottom="16" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Gestion des activités" styleClass="page-title"/>
                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="← Home"
                        onAction="#goHome"
                        styleClass="home-btn-small"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Rechercher (nom, catégorie, niveau)..."
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="filterCategorie" prefWidth="170" promptText="Catégorie" styleClass="filter-combo"/>
                <ComboBox fx:id="filterNiveau" prefWidth="170" promptText="Niveau" styleClass="filter-combo"/>
                <ComboBox fx:id="sortBox" prefWidth="170" promptText="Trier" styleClass="filter-combo"/>

                <Button text="Rafraîchir" onAction="#onRefresh" styleClass="btn-secondary"/>
            </HBox>

            <Region styleClass="accent-line-thin"/>
        </VBox>
    </top>

    <center>
        <StackPane styleClass="page-body">
            <padding>
                <Insets top="18" right="22" bottom="22" left="22"/>
            </padding>

            <VBox spacing="16" styleClass="content-root">

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="section-bar">
                    <Label text="Galerie Premium" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="+ Nouveau" onAction="#onShowAjouter" styleClass="btn-primary pill"/>
                </HBox>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="content-scroll">
                    <content>
                        <VBox styleClass="grid-wrapper">
                            <padding>
                                <Insets top="8" right="0" bottom="0" left="0"/>
                            </padding>

                            <TilePane fx:id="cardsPane"
                                      prefColumns="3"
                                      prefTileWidth="360"
                                      prefTileHeight="330"
                                      hgap="22" vgap="22"
                                      tileAlignment="TOP_LEFT"
                                      styleClass="cards-grid"/>
                        </VBox>
                    </content>
                </ScrollPane>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
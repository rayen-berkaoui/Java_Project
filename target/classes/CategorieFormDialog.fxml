<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.CategorieFormDialogController"
            styleClass="dialog-pane" prefWidth="580" prefHeight="500">
    <content>
        <VBox spacing="0" styleClass="dialog-content-root" alignment="TOP_CENTER">

            <!-- Dialog Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dialog-header-section">
                <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>
                <Label text="📂" style="-fx-font-size: 30px;"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Catégorie" styleClass="dialog-page-title" style="-fx-font-size: 22px;"/>
                    <Label text="Remplissez les informations de la catégorie" styleClass="dialog-page-subtitle"/>
                </VBox>
                <Button fx:id="btnFullscreen" text="⛶" styleClass="btn-fullscreen" mnemonicParsing="false"/>
            </HBox>

            <!-- Gold Separator -->
            <Region styleClass="accent-line" prefHeight="2" maxHeight="2"/>

            <!-- Form Section - centered card -->
            <VBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
                <VBox spacing="22" styleClass="form-section" maxWidth="480">
                    <padding><Insets top="28" right="35" bottom="28" left="35"/></padding>
                    <Label text="📝 Informations" styleClass="form-section-title" style="-fx-font-size: 16px;"/>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Nom de la catégorie" styleClass="form-field-label" style="-fx-font-size: 13px;"/>
                        <TextField fx:id="tfNom" promptText="Entrez le nom..." styleClass="form-input" prefHeight="42"/>
                        <Label fx:id="lblErrNom" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" styleClass="form-group">
                        <Label text="Description" styleClass="form-field-label" style="-fx-font-size: 13px;"/>
                        <TextField fx:id="tfDescription" promptText="Décrivez la catégorie..." styleClass="form-input" prefHeight="42"/>
                        <Label fx:id="lblErrDesc" text="" styleClass="error-label" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>
